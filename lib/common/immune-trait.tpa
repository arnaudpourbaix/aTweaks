DEFINE_PATCH_FUNCTION poison_immunity
	INT_VAR index = 8
	STR_VAR result = ""
BEGIN
	DEFINE_ARRAY spells BEGIN
		~SPWI016~
		~SPWI502~
		~dvckill~
		~RR#WI502~
		~SPIN979~
		~SPIN642~
		~RR#SPOI1~
		~RR#spwrt~
	END
	DEFINE_ARRAY identifiers BEGIN  END
	PATCH_PHP_EACH identifiers AS _ => ids BEGIN
		LPF getResourceFromSpellIds STR_VAR ids RET result END
		SPRINT $spells(~%index%~) ~%result%~
		SET index = index + 1
	END
	LPF ADD_IMMUNITY_CRE_ITM_SPL STR_VAR effects="25" prevent_icons="6" strings="14017 14662 26215 25425" spells END
	LPF ADD_EFFECT_CRE_ITM_SPL INT_VAR opcode=173 parameter1=100 END
	LPF ADD_EFFECT_CRE_ITM_SPL INT_VAR opcode=328 parameter2=141 special=1 END
END

