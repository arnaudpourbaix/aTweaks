DEFINE_PATCH_FUNCTION deathSpell_immunity
	INT_VAR index = 2
	STR_VAR result = ""
BEGIN
	DEFINE_ARRAY spells BEGIN
		~SPWI605~
		~cdxvdth~
	END
	DEFINE_ARRAY identifiers BEGIN  END
	PATCH_PHP_EACH identifiers AS _ => ids BEGIN
		LPF getResourceFromSpellIds STR_VAR ids RET result END
		SPRINT $spells(~%index%~) ~%result%~
		SET index = index + 1
	END
	LPF ADD_IMMUNITY_CRE_ITM_SPL INT_VAR displaySpellIneffective=1 STR_VAR spells END
END

DEFINE_PATCH_FUNCTION mindSpells_immunity
BEGIN
	LPF ADD_IMMUNITY_CRE_ITM_SPL STR_VAR effects="3" END
	LPF charm_immunity END
	LPF fear_immunity END
	LPF confusion_immunity END
	LPF illusion_immunity END
END

