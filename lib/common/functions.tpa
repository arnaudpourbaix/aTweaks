// Clear BG1 weapon proficiencies
DEFINE_PATCH_FUNCTION clear_bg1_profs BEGIN
  READ_ASCII 0 sig (3)
  PATCH_MATCH "%sig%" WITH
    ~CRE~ BEGIN
      PATCH_FOR_EACH ~bg1_prof~ IN ~0x6e~ ~0x6f~ ~0x70~ ~0x71~ ~0x72~ ~0x73~ ~0x74~ ~0x75~ BEGIN
        WRITE_BYTE %bg1_prof% 0
      END
    END
  DEFAULT END
END


