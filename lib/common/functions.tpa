    ~CA#PAOO~ // Polymorph Other (Pnp Celestial)
  END
  LPF ADD_IMMUNITY_CRE_ITM_SPL INT_VAR displaySpellIneffective=1 STR_VAR effects=135 prevent_icons=124 strings="339 351 809 1482 54332 14128" spells END
END


