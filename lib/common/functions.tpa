    157 => 4  // Antisolar
    158 => 4  // Planatar
    159 => 4  // Darkplanatar
    186 => 5  // Elemental_Air
    132 => 5  // Fairy_Nereid
  END
  DEFINE_ARRAY spells BEGIN  
    ~SPOGRE01~ // Earthquake (Ogremoch)
     ~SPPR720~ // Earthquake (Priest version)
     ~rr#equa~ // Earthquake (aTweaks)
