ACTION_FOR_EACH ~file~ IN
	BDHELP04
	CATJAG01
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~CATJAG~
			ADD_CRE_ITEM ~ja#1m34~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~ja#2m34~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=4
					strength=14
					dexterity=15
					constitution=10
					intelligence=4
					wisdom=14
					charisma=7
					movement=12
