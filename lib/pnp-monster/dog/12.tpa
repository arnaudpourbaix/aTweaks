// Wild Dog
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/dog/ja#m12.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/dog/ja#m12su.baf~

// Jaws
CREATE ITM "ja#1m12"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10162)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10162)
	WRITE_ASCII 0x3a ~SPPR416B~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10467)
COPY_EXISTING ~ja#1m12.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~SPPR416B~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 1
		WRITE_BYTE 0x84 3
		WRITE_BYTE 0x88 4
		WRITE_BYTE 0x8a 1
		WRITE_SHORT 0x8e 1
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	END

ACTION_FOR_EACH ~file~ IN
	BDBDOG
	BDDEADOG
	DOGWI
	DOGWISU
	BDCRUDOG
	BDDOG
	DW#RNDWI
	BDDOGW01
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDBDOG~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDDEADOG~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DOGWI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DOGWISU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDCRUDOG~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDDOG~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DW#RNDWI~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDDOGW01~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~P1-4~
			REPLACE_CRE_ITEM ~ja#1m12~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=1
					bonusHp=1
					strength=12
					dexterity=17
					constitution=15
					intelligence=4
					wisdom=13
					charisma=11
					ac=10
					thac0=19
					apr=1
					xpv=35
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					morale=6
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~DOG~)
					class=IDS_OF_SYMBOL (~class~ ~DOG_WILD~)
					gender=IDS_OF_SYMBOL (~gender~ ~MALE~)
					sex=IDS_OF_SYMBOL (~gender~ ~MALE~)
					movement=12
					hp=9
					saveDeath=14
					saveWand=16
					savePolymorph=15
					saveBreath=17
					saveSpell=17
					enforce=1
			END
			// Assigning ja#m12 to slot Default
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#MG29 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#GPSHM DW#GPSHT dw1melbe DW1MELGE DW#PRSHT DW1RANGE dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT TUTU_SCR WTASIGHT WDASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN DOGWISU BDDEADOG END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR slot=Default removeScripts skipFiles script=ja#m12 END
			// Assigning ja#m12su to slot Default
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#MG29 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#GPSHM DW#GPSHT dw1melbe DW1MELGE DW#PRSHT DW1RANGE dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT TUTU_SCR WTASIGHT WDASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN DOGWISU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR slot=Default files removeScripts script=ja#m12su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~DOGWISU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDDOG~) BEGIN 
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~INNOCENT~) // class
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDDEADOG~) BEGIN 
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END