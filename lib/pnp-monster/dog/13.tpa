			DEFINE_ARRAY skipFiles BEGIN DOGWASU UBNIMDOG END
			LPF patchCreatureScript STR_VAR script=ja#m13 slot=Default skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDGRSHTV BDNONIN BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#MG84 DW#GPSHM DW#GPSHT DW1MELGE DW#PRSHT DW1RANGE dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT WTASIGHT WDASIGHT wtrunsgt END
