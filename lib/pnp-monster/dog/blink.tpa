					gender=IDS_OF_SYMBOL (~gender~ ~MALE~)
					sex=IDS_OF_SYMBOL (~gender~ ~MALE~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN PSPIDER END
			LPF patchCreatureScript STR_VAR script=ja#m14 removeScripts END
		BUT_ONLY_IF_IT_CHANGES
