// Spectral Hound
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/dog/ja#m39.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/dog/ja#m39su.baf~

// Astral Plane Shift
CREATE SPL "ja#1m39"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~ja#1m39.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10154)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 1
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10316)
