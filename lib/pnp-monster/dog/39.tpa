	LPF ADD_EFFECT INT_VAR header=1 opcode=66 target=2 power=1 parameter1=99 resist_dispel=1 duration=36 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=9 target=2 power=1 parameter1=2105376000 parameter2=1966335 resist_dispel=1 duration=36 probability1=100 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=61 target=2 power=1 parameter1=1511938560 parameter2=1638400 resist_dispel=1 duration=36 probability1=100 END
	
	// Jaws
