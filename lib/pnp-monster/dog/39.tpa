	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	LPF ADD_EFFECT INT_VAR opcode=146 target=2 parameter2=1 probability1=100 STR_VAR resource="ja#1m39" END
	END

ACTION_FOR_EACH ~file~ IN
	BDSHA01C
	DOGWAWP
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDSHA01C~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DOGWAWP~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~FIGRING3~
			REMOVE_CRE_ITEM ~IPSION~
			REMOVE_CRE_ITEM ~BDSPIRIM~
			REMOVE_CRE_ITEM ~DOGWAWP~
			REMOVE_CRE_ITEM ~BDSHA01C~
			REPLACE_CRE_ITEM ~ja#1m39~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=5
					bonusHp=0
					strength=17
					dexterity=15
					constitution=14
					intelligence=4
					wisdom=14
					charisma=12
					ac=0
					apr=1
					xpv=975
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					morale=19
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~DOG~)
					class=IDS_OF_SYMBOL (~class~ ~DOG_WAR~)
					gender=IDS_OF_SYMBOL (~gender~ ~MALE~)
					sex=IDS_OF_SYMBOL (~gender~ ~MALE~)
					movement=12
					hp=40
					thac0=15
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN WARDOG BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDGRSHTV BDNONIN BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#GPSHM DW#GPSHT DW#PRSHT dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT WTASIGHT WDASIGHT wtrunsgt END
			DEFINE_ARRAY skipFiles BEGIN BDSHA01C END
			LPF patchCreatureScript STR_VAR script=ja#m39 slot=Default skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN WARDOG BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDGRSHTV BDNONIN BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#GPSHM DW#GPSHT DW#PRSHT dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT WTASIGHT WDASIGHT wtrunsgt END
			DEFINE_ARRAY files BEGIN BDSHA01C END
			LPF patchCreatureScript STR_VAR script=ja#m39su slot=Default files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDSHA01C~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END