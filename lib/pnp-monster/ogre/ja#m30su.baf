// Potion of speed
IF
	HasItem("POTN14",Myself)
	!GlobalTimerNotExpired("JA#ROUND","LOCALS")
	RandomNumLT(888,100)
THEN
	RESPONSE #100
		DisplayStringHead(Myself,@3002)
		SetGlobalTimer("JA#ROUND","LOCALS",6)
		UseItem("POTN14",Myself)
END

// Attack Slowed enemy
IF
	OR(6)
		!StateCheck([PC.0.0.MAGE_ALL],STATE_SLOWED)
		General([PC.0.0.MAGE_ALL],WEAPON)
		StateCheck([PC.0.0.MAGE_ALL],STATE_INVISIBLE)
		CheckStatGT([PC.0.0.MAGE_ALL],0,SANCTUARY)
		StateCheck([PC.0.0.MAGE_ALL],STATE_REALLY_DEAD)
		!See([PC.0.0.MAGE_ALL])
	OR(6)
		!StateCheck([PC.0.0.CLERIC_ALL],STATE_SLOWED)
		General([PC.0.0.CLERIC_ALL],WEAPON)
		StateCheck([PC.0.0.CLERIC_ALL],STATE_INVISIBLE)
		CheckStatGT([PC.0.0.CLERIC_ALL],0,SANCTUARY)
		StateCheck([PC.0.0.CLERIC_ALL],STATE_REALLY_DEAD)
		!See([PC.0.0.CLERIC_ALL])
	OR(6)
		!StateCheck([PC.0.0.DRUID_ALL],STATE_SLOWED)
		General([PC.0.0.DRUID_ALL],WEAPON)
		StateCheck([PC.0.0.DRUID_ALL],STATE_INVISIBLE)
		CheckStatGT([PC.0.0.DRUID_ALL],0,SANCTUARY)
		StateCheck([PC.0.0.DRUID_ALL],STATE_REALLY_DEAD)
		!See([PC.0.0.DRUID_ALL])
	OR(6)
		!StateCheck([PC.0.0.BARD],STATE_SLOWED)
		General([PC.0.0.BARD],WEAPON)
		StateCheck([PC.0.0.BARD],STATE_INVISIBLE)
		CheckStatGT([PC.0.0.BARD],0,SANCTUARY)
		StateCheck([PC.0.0.BARD],STATE_REALLY_DEAD)
		!See([PC.0.0.BARD])
THEN
	RESPONSE #100
		Continue()
END

IF
	StateCheck(LastSeenBy(Myself),STATE_SLOWED)
	!General(LastSeenBy(Myself),WEAPON)
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	!CheckStatGT(LastSeenBy(Myself),0,SANCTUARY)
	!StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
	See(LastSeenBy(Myself))
THEN
	RESPONSE #100
		AttackOneRound(LastSeenBy(Myself))
END

