COMPILE ~%MOD_FOLDER%/lib/pnp-monster/ogre/ja#m32.baf~

COPY_EXISTING "CONECOLD.pro" ~override/ja#1m32.pro~
	READ_SHORT 0x08 type
	PATCH_IF (%type% = 1) BEGIN
		INSERT_BYTES 0x100 0x100
	END
	WRITE_LONG 0x200 2048
	WRITE_SHORT 0x204 620
	WRITE_SHORT 0x206 620
ADD_PROJECTILE ~override/ja#1m32.pro~ ~Ogre-Mage Cone of Cold~

	// Cone of Cold
CREATE SPL "ja#1m32"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x28
	WRITE_SHORT 0x68 1
	WRITE_LONG 0x6a 0x9a
	WRITE_SHORT 0x72 1
	WRITE_SHORT 0x82 1
	WRITE_ASCII 0x3a ~SPWI503C~ #8
	WRITE_ASCII 0x76 ~SPWI503B~ #8
	WRITE_SHORT 0x22 15
	WRITE_SHORT 0x1c 1
	WRITE_BYTE 0x25 6
	WRITE_BYTE 0x27 10
	WRITE_LONG 0x34 5
	WRITE_ASCII 0x10 ~CAS_M06~ #8
	WRITE_SHORT 0x74 2
	WRITE_BYTE 0x7e 1
	WRITE_SHORT 0x80 10
	WRITE_SHORT 0x84 1
	WRITE_LONG 0x8 26492
	WRITE_LONG 0xc 26492
	WRITE_SHORT 0x98 (IDS_OF_SYMBOL (~projectl~ ~ja#1m32~)) + 1
	LPF ADD_EFFECT
		INT_VAR
			opcode = 12
			target = 2
			parameter2 = 131072
			probability1 = 100
			dicenumber = 8
			dicesize = 8
			savingthrow = 16777217
			savebonus = "-4"
			special = 256
		END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 165
			target = 2
			duration = 1
			probability1 = 100
		END

	// Fly
CREATE SPL "ja#2m32"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x28
	WRITE_SHORT 0x68 1
	WRITE_LONG 0x6a 0x9a
	WRITE_SHORT 0x72 1
	WRITE_SHORT 0x82 1
	WRITE_ASCII 0x3a ~SPWI305C~ #8
	WRITE_ASCII 0x76 ~SPWI305B~ #8
	WRITE_SHORT 0x22 10
	WRITE_SHORT 0x1c 1
	WRITE_BYTE 0x25 8
	WRITE_BYTE 0x27 13
	WRITE_LONG 0x34 3
	WRITE_ASCII 0x10 ~CAS_M08~ #8
	WRITE_SHORT 0x74 2
	WRITE_BYTE 0x7e 5
	WRITE_SHORT 0x84 3
	WRITE_LONG 0x8 RESOLVE_STR_REF(@4015)
	WRITE_LONG 0xc RESOLVE_STR_REF(@4015)
	LPF ADD_EFFECT
		INT_VAR
			opcode = 176
			target = 2
			parameter1 = 13
			parameter2 = 1
			duration = 72
			probability1 = 100
		END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 143
			target = 2
			parameter1 = IDS_OF_SYMBOL (~slots~ ~SLOT_BOOTS~)
			duration = 72
			probability1 = 100
		STR_VAR
			resource = "ja#i3"
		END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 328
			target = 2
			parameter2 = (IDS_OF_SYMBOL (~splstate~ ~JA_FLYING~))
			duration = 72
			probability1 = 100
			special = 1
		END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 142
			target = 2
			parameter2 = 38
			duration = 72
			probability1 = 100
		END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 174
			target = 2
			probability1 = 100
		STR_VAR
			resource = "EFF_M28"
		END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 174
			target = 2
			timing = 4
			duration = 72
			probability1 = 100
		STR_VAR
			resource = "EFF_M29"
		END

	// Gaseous form
CREATE SPL "ja#3m32"
	WRITE_LONG 0x64 0x72
