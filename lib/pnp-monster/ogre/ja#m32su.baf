// Attack Slowed enemy
IF
	OR(12)
		!StateCheck([PC.0.0.MAGE_ALL],STATE_SLOWED)
		CheckStatGT([PC.0.0.MAGE_ALL],0,HELD)
		StateCheck([PC.0.0.MAGE_ALL],STATE_STUNNED)
		StateCheck([PC.0.0.MAGE_ALL],STATE_PANIC)
		StateCheck([PC.0.0.MAGE_ALL],STATE_CONFUSED)
		StateCheck([PC.0.0.MAGE_ALL],STATE_FEEBLEMINDED)
		StateCheck([PC.0.0.MAGE_ALL],STATE_SLEEPING)
		StateCheck([PC.0.0.MAGE_ALL],STATE_HELPLESS)
		General([PC.0.0.MAGE_ALL],WEAPON)
		CheckStatGT([PC.0.0.MAGE_ALL],0,SANCTUARY)
		StateCheck([PC.0.0.MAGE_ALL],STATE_REALLY_DEAD)
		!See([PC.0.0.MAGE_ALL])
	OR(12)
		!StateCheck([PC.0.0.CLERIC_ALL],STATE_SLOWED)
		CheckStatGT([PC.0.0.CLERIC_ALL],0,HELD)
		StateCheck([PC.0.0.CLERIC_ALL],STATE_STUNNED)
		StateCheck([PC.0.0.CLERIC_ALL],STATE_PANIC)
		StateCheck([PC.0.0.CLERIC_ALL],STATE_CONFUSED)
		StateCheck([PC.0.0.CLERIC_ALL],STATE_FEEBLEMINDED)
		StateCheck([PC.0.0.CLERIC_ALL],STATE_SLEEPING)
		StateCheck([PC.0.0.CLERIC_ALL],STATE_HELPLESS)
		General([PC.0.0.CLERIC_ALL],WEAPON)
		CheckStatGT([PC.0.0.CLERIC_ALL],0,SANCTUARY)
		StateCheck([PC.0.0.CLERIC_ALL],STATE_REALLY_DEAD)
		!See([PC.0.0.CLERIC_ALL])
	OR(12)
		!StateCheck([PC.0.0.DRUID_ALL],STATE_SLOWED)
		CheckStatGT([PC.0.0.DRUID_ALL],0,HELD)
		StateCheck([PC.0.0.DRUID_ALL],STATE_STUNNED)
		StateCheck([PC.0.0.DRUID_ALL],STATE_PANIC)
		StateCheck([PC.0.0.DRUID_ALL],STATE_CONFUSED)
		StateCheck([PC.0.0.DRUID_ALL],STATE_FEEBLEMINDED)
		StateCheck([PC.0.0.DRUID_ALL],STATE_SLEEPING)
		StateCheck([PC.0.0.DRUID_ALL],STATE_HELPLESS)
		General([PC.0.0.DRUID_ALL],WEAPON)
		CheckStatGT([PC.0.0.DRUID_ALL],0,SANCTUARY)
		StateCheck([PC.0.0.DRUID_ALL],STATE_REALLY_DEAD)
		!See([PC.0.0.DRUID_ALL])
	OR(12)
		!StateCheck([PC.0.0.BARD],STATE_SLOWED)
		CheckStatGT([PC.0.0.BARD],0,HELD)
		StateCheck([PC.0.0.BARD],STATE_STUNNED)
		StateCheck([PC.0.0.BARD],STATE_PANIC)
		StateCheck([PC.0.0.BARD],STATE_CONFUSED)
		StateCheck([PC.0.0.BARD],STATE_FEEBLEMINDED)
		StateCheck([PC.0.0.BARD],STATE_SLEEPING)
		StateCheck([PC.0.0.BARD],STATE_HELPLESS)
		General([PC.0.0.BARD],WEAPON)
		CheckStatGT([PC.0.0.BARD],0,SANCTUARY)
		StateCheck([PC.0.0.BARD],STATE_REALLY_DEAD)
		!See([PC.0.0.BARD])
THEN
	RESPONSE #100
		Continue()
END

