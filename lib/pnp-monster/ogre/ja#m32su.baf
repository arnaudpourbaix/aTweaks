// Summons are destroyed on death
IF
	Die()
THEN
	RESPONSE #100
		DestroySelf()
END

// Random walk on panic
IF
	StateCheck(Myself,STATE_PANIC)
THEN
	RESPONSE #100
		RandomWalkContinuous()
END

// Detect combat
IF
	Global("JA#COMBAT","LOCALS",0)
	See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetGlobal("JA#COMBAT","LOCALS",1)
		Shout(98)
END

// React to shouts
IF
	Global("JA#COMBAT","LOCALS",0)
	Heard(LastSummonerOf(Myself),98)
THEN
	RESPONSE #100
		SetGlobal("JA#COMBAT","LOCALS",1)
END

// Summon follow summoner
IF
	Global("JA#COMBAT","LOCALS",0)
	!StateCheck(Myself,STATE_BLIND)
	ActionListEmpty()
	!See(NearestEnemyOf(Myself))
	!See(LastSummonerOf(Myself))
	HPGT(LastSummonerOf(Myself),0)
	Range(LastSummonerOf(Myself),150)
THEN
	RESPONSE #100
		MoveToObject(LastSummonerOf(Myself))
END

// Do nothing if combat is not started
IF
	Global("JA#COMBAT","LOCALS",0)
	ActionListEmpty()
THEN
	RESPONSE #100
		NoAction()
END

// Invisibility
IF
	!GlobalTimerNotExpired("JA#ROUND","LOCALS")
	!GlobalTimerNotExpired("invisible","LOCALS")
	Detect(NearestEnemyOf(Myself))
	HaveSpell(WIZARD_INVISIBILITY)
	!StateCheck(Myself,STATE_INVISIBLE)
	RandomNumGT(800,240)
THEN
	RESPONSE #100
		SpellNoDec(Myself,WIZARD_INVISIBILITY)
		SetGlobalTimer("invisible","LOCALS",18)
		SetGlobalTimer("JA#ROUND","LOCALS",6)
END

// Fly
IF
	!GlobalTimerNotExpired("JA#ROUND","LOCALS")
	Detect(NearestEnemyOf(Myself))
	StateCheck(Myself,STATE_INVISIBLE)
	HaveSpellRES("ja#2m32")
	!CheckSpellState(Myself,JA_FLYING)
	RandomNumGT(801,80)
THEN
	RESPONSE #100
		SpellNoDecRES("ja#2m32",Myself)
		SetGlobalTimer("JA#ROUND","LOCALS",6)
END

// Domination
IF
	HaveSpell(WIZARD_DOMINATION)
	RandomNumGT(802,241)
	!GlobalTimerNotExpired("JA#ROUND","LOCALS")
	!Race([PC.0.0.FIGHTER],ELF)
	!CheckStatGT([PC.0.0.FIGHTER],0,HELD)
	!StateCheck([PC.0.0.FIGHTER],STATE_STUNNED)
	!StateCheck([PC.0.0.FIGHTER],STATE_PANIC)
	!StateCheck([PC.0.0.FIGHTER],STATE_CONFUSED)
	!StateCheck([PC.0.0.FIGHTER],STATE_FEEBLEMINDED)
	!StateCheck([PC.0.0.FIGHTER],STATE_SLEEPING)
	!StateCheck([PC.0.0.FIGHTER],STATE_HELPLESS)
	!General([PC.0.0.FIGHTER],WEAPON)
	!StateCheck([PC.0.0.FIGHTER],STATE_IMPROVEDINVISIBILITY)
	!StateCheck([PC.0.0.FIGHTER],STATE_INVISIBLE)
	!CheckStatGT([PC.0.0.FIGHTER],0,SANCTUARY)
	!StateCheck([PC.0.0.FIGHTER],STATE_CHARMED)
	!StateCheck([PC.0.0.FIGHTER],STATE_REALLY_DEAD)
	See([PC.0.0.FIGHTER])
	!CheckStatGT([PC.0.0.FIGHTER],0,HELD)
	!StateCheck([PC.0.0.FIGHTER],STATE_STUNNED)
	!StateCheck([PC.0.0.FIGHTER],STATE_PANIC)
	!StateCheck([PC.0.0.FIGHTER],STATE_CONFUSED)
	!StateCheck([PC.0.0.FIGHTER],STATE_FEEBLEMINDED)
	!StateCheck([PC.0.0.FIGHTER],STATE_SLEEPING)
	!StateCheck([PC.0.0.FIGHTER],STATE_HELPLESS)
	!General([PC.0.0.FIGHTER],WEAPON)
	!StateCheck([PC.0.0.FIGHTER],STATE_IMPROVEDINVISIBILITY)
	!StateCheck([PC.0.0.FIGHTER],STATE_INVISIBLE)
	!CheckStatGT([PC.0.0.FIGHTER],0,SANCTUARY)
	!StateCheck([PC.0.0.FIGHTER],STATE_CHARMED)
	!StateCheck([PC.0.0.FIGHTER],STATE_REALLY_DEAD)
	See([PC.0.0.FIGHTER])
	RandomNumGT(1000,167)
THEN
	RESPONSE #100
		Spell([PC.0.0.FIGHTER],WIZARD_DOMINATION)
		SetGlobalTimer("JA#ROUND","LOCALS",6)
END

