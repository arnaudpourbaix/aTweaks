			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~KROTAN~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~NTKROTAN~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~KAHRK~) BEGIN 
