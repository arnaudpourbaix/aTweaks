				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDWAVE16~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~WIOGMA01~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~WIGENTLE~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~DROTH~) BEGIN 
