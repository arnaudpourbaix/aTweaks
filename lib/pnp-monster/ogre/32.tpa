// Ogre Mage
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/ogre/ja#m32.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/ogre/ja#m32su.baf~

// Ogre Mage traits
CREATE ITM "ja#1m32"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10461)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10461)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10462)
COPY_EXISTING ~ja#1m32.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
	END
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=98 target=1 global=1 parameter1=6 parameter2=3 timing=2 probability1=100 END

// Attach movement speed to item
COPY_EXISTING ~ja#5f10.ITM~  ~override~
	LPF ADD_ITEM_EQEFFECT INT_VAR opcode=176 target=1 timing=2 parameter1=7 parameter2=1 global=1 END

