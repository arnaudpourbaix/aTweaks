				WRITE_BYTE 0x235 9 // level2
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~FIGHTER_MAGE~) // class
				ADD_MEMORIZED_SPELL ~ja#1f10~ #4 ~wizard~ (1) // Cone of Cold
				ADD_MEMORIZED_SPELL ~SPWI316~ #2 ~wizard~ (2) 
