COMPILE ~%MOD_FOLDER%/lib/pnp-monster/basilisk/ja#m2.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/basilisk/ja#m2su.baf~

CREATE SPL "ja#m2s1"
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 1
	WRITE_LONG 0x64 0x72
	WRITE_SHORT 0x68 1
	WRITE_LONG 0x6a 0x9a
	INSERT_BYTES 0x72 0x28
	WRITE_SHORT 0x72 2
	WRITE_SHORT 0x74 4
	WRITE_BYTE 0x7e 1
	WRITE_SHORT 0x80 30
	WRITE_SHORT 0x82 1
	WRITE_SHORT 0x94 1
	SAY NAME1 @4002 SAY NAME2 @4002
	SAY UNIDENTIFIED_DESC ~Any creature, that can see and within 30 feet of the basilisk, must save vs petrify at -4. On a failed save, the creature magically begins to turn to stone and is restrained. It must repeat the saving throw at the end of its next turn. On a success, the effect ends. On a failure, the creature is petrified until freed by the greater restoration spell or other magic.~
	WRITE_SHORT 0x98 65
	LPF ADD_EFFECT
		INT_VAR
			opcode = 146
			target = 2
			parameter1 = 0
			parameter2 = 1
			timing = 3
			duration = 12
			probability1 = 100
			savingthrow = 16
			savebonus = "-4"
		STR_VAR
			resource = "ja#m2s2"
	END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 142
			target = 2
			parameter1 = 0
			parameter2 = 41
			duration = 12
			probability1 = 100
			savingthrow = 16
			savebonus = "-4"
	END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 139
			target = 2
			parameter1 = RESOLVE_STR_REF(@4003)
			parameter2 = 0
			duration = 12
			probability1 = 100
			savingthrow = 16
			savebonus = "-4"
	END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 141
			target = 2
			parameter1 = 0
			parameter2 = 13
			probability1 = 100
			savingthrow = 16
			savebonus = "-4"
	END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 176
			target = 2
			parameter1 = 0
			parameter2 = 1
			duration = 12
			probability1 = 100
			savingthrow = 16
			savebonus = "-4"
	END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 109
			target = 2
			parameter1 = (IDS_OF_SYMBOL (~EA~ ~INANIMATE~))
			parameter2 = 2
			probability1 = 100
			savingthrow = 16
			savebonus = "-4"
	END

