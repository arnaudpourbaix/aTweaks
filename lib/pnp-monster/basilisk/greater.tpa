COMPILE ~%MOD_FOLDER%/lib/pnp-monster/basilisk/ja#m3.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/basilisk/ja#m3su.baf~

CREATE ITM "ja#m3w1"
	WRITE_LONG 0x64 0x72
	WRITE_SHORT 0x68 1
	WRITE_LONG 0x6a 0xaa
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x72 1
	WRITE_SHORT 0x74 1
	WRITE_BYTE 0x7e 1
	WRITE_SHORT 0x80 1
	WRITE_SHORT 0x84 3
	WRITE_BYTE 0x88 10
	WRITE_BYTE 0x8a 1
	WRITE_SHORT 0x8e 3
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	LPF set_enchantment INT_VAR enchantment = 0 END

ACTION_FOR_EACH ~file~ IN
	AC#BASGR
	BASILG
	BASILGSU
	BASILMUT
	BASILNAD
	BD302BAS
	BPBASG01
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~BASILG1~
			REMOVE_CRE_ITEM ~BASILG2~
			REMOVE_CRE_ITEM ~BASILG3~
			ADD_CRE_ITEM ~ja#m3w1~ #0 #0 #0 ~UNDROPPABLE~ ~weapon1~ EQUIP
			LPF patchCreature
				INT_VAR
					level1=6
					strength=15
					dexterity=8
					constitution=15
					intelligence=2
					wisdom=12
					charisma=11
					movement=6
					hp=48
					ac=4
					thac0=15
					apr=1
					xpv=1400
					alignment=34
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					morale=12
					moraleBreak=4
					moraleRecovery=15
					general=255
					race=102
					class=102
					gender=4
					sex=4
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN
				GBASILSK
				SHOUT
				WTASIGHT
				wtrunsgt
				DW2MP0GE
				DW2RC2MO
			END
			LPF patchCreatureScript STR_VAR script=ja#m3 removeScripts skipFiles END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BASILGSU~) BEGIN 
				DEFINE_ARRAY removeScripts BEGIN
					ja#m3
					GBASILSK
					SHOUT
					WTASIGHT
					wtrunsgt
					DW2MP0GE
					DW2RC2MO
				END
				LPF patchCreatureScript STR_VAR script=ja#m3su removeScripts skipFiles END
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END