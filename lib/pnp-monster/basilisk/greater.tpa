ACTION_FOR_EACH ~file~ IN
	AC#BASGR
	BASILG
	BASILGSU
	BASILMUT
	BASILNAD
	BD302BAS
	BPBASG01
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~BASILG1~
			REMOVE_CRE_ITEM ~BASILG2~
			REMOVE_CRE_ITEM ~BASILG3~
			REPLACE_CRE_ITEM ~ja#1m3~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~ja#2m3~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			ADD_MEMORIZED_SPELL ~ja#1m2~ #0 ~innate~ (1)
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=10
					strength=20
					dexterity=8
					constitution=19
					intelligence=7
					wisdom=12
					charisma=11
					movement=5
					hp=125
					ac=2
					thac0=11
					apr=2
					xpv=7000
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					morale=16
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~BASILISK~)
					class=IDS_OF_SYMBOL (~class~ ~BASILISK_GREATER~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					enforce=1
					perfect2weapon=1
			END
			DEFINE_ARRAY removeScripts BEGIN GBASILSK END
			DEFINE_ARRAY skipFiles BEGIN BASILGSU END
			LPF patchCreatureScript STR_VAR script=ja#m3 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN GBASILSK END
			DEFINE_ARRAY files BEGIN BASILGSU END
			LPF patchCreatureScript STR_VAR script=ja#m3su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BASILGSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END