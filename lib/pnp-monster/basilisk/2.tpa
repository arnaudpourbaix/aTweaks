// Generated file (don't edit)

// Lesser Basilisk
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/basilisk/ja#m2.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/basilisk/ja#m2su.baf~

// Petrifying Gaze
COPY_EXISTING "gaze.pro" ~override/ja#1m2.pro~
	READ_SHORT 0x08 type
	PATCH_IF (%type% = 1) BEGIN
		INSERT_BYTES 0x100 0x100
	END
	PATCH_IF (%type% != 3) BEGIN
		INSERT_BYTES 0x200 0x100
	END
	WRITE_SHORT 0x8 3
	WRITE_LONG 0x200 2112
	WRITE_SHORT 0x204 255
	WRITE_SHORT 0x206 255
	WRITE_SHORT 0x212 0x4001
	WRITE_BYTE 0x217 255
	WRITE_SHORT 0x224 60
ADD_PROJECTILE ~override/ja#1m2.pro~ ~Basilisk petrifying gaze~

CREATE SPL "ja#1m2"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~ja#1m2.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10099)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 11
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI604C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10100)
	LPF ADD_SPELL_HEADER INT_VAR type=2 location=4 target=1 range=30 projectile=(IDS_OF_SYMBOL (~projectl~ ~ja#1m2~)) + 1 STR_VAR icon="SPWI604C" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=134 target=2 power=1 probability1=100 savingthrow=16 savebonus="-4" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=139 target=2 power=1 parameter1=RESOLVE_STR_REF(@10101) probability1=100 savingthrow=16 savebonus="-4" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 probability1=100 savingthrow=16 savebonus="-4" STR_VAR resource="MISC_06B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=2 power=1 probability1=100 savingthrow=16 savebonus="-4" STR_VAR resource="SPFLESHS.VVC" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=61 target=2 power=1 parameter1=2021160960 parameter2=1638400 probability1=100 savingthrow=16 savebonus="-4" END
	LPF CHANGE_SPELL INT_VAR    renew=1 END
	
	// Jaws
CREATE ITM "ja#1m2"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10098)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10098)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~SPPR416B~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10236)
	WRITE_LONG 0x60 1
COPY_EXISTING ~ja#1m2.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~SPPR416B~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 1
		WRITE_BYTE 0x84 5
		WRITE_BYTE 0x88 10
		WRITE_BYTE 0x8a 1
		WRITE_SHORT 0x8e 1
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	END

ACTION_FOR_EACH ~file~ IN
	BASILL
	BASILLSU
	BPBASL01
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_CRE_EFFECTS
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~BASILL1~
			REMOVE_CRE_ITEM ~BASILL2~
			REPLACE_CRE_ITEM ~ja#1m2~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~ja#i11~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~ja#1m2~ #0 ~innate~ (1)
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=6
					bonusHp=1
					strength=16
					dexterity=8
					constitution=15
					intelligence=2
					wisdom=8
					charisma=7
					ac=4
					apr=1
					xpv=1400
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					morale=12
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~BASILISK~)
					class=IDS_OF_SYMBOL (~class~ ~BASILISK~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					movement=5
					hp=54
					thac0=15
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN LBASILSK BDGRSHTV BDANIMN BDNONIN DW#GPSHM dw1ranmo DW2MP0GE DW2RC2MO HUNTER SHOUT WTASIGHT WDASIGHT wtrunsgt END
			DEFINE_ARRAY skipFiles BEGIN BASILLSU END
			LPF patchCreatureScript STR_VAR script=ja#m2 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN LBASILSK BDGRSHTV BDANIMN BDNONIN DW#GPSHM dw1ranmo DW2MP0GE DW2RC2MO HUNTER SHOUT WTASIGHT WDASIGHT wtrunsgt END
			DEFINE_ARRAY files BEGIN BASILLSU END
			LPF patchCreatureScript STR_VAR script=ja#m2su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BASILLSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END