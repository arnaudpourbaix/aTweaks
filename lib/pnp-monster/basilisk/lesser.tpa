CREATE ITM "ja#m2w1"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x60 1
	WRITE_SHORT 0x74 1
	WRITE_BYTE 0x7e 1
	WRITE_SHORT 0x80 1
	WRITE_SHORT 0x84 3
	WRITE_BYTE 0x88 10
	WRITE_BYTE 0x8a 1
	WRITE_SHORT 0x8e 3
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
COPY_EXISTING ~ja#m2w1.itm~ ~override~

ACTION_FOR_EACH ~file~ IN
	BASILL
	BASILLSU
	BPBASL01
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~BASILL1~
			REMOVE_CRE_ITEM ~BASILL2~
			ADD_CRE_ITEM ~ja#m2w1~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_MEMORIZED_SPELL ~ja#1m2~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~ja#2m2~ #0 ~innate~ (1)
			LPF clearProficiencies END
			LPF patchCreature
				INT_VAR
					level1=6
					strength=16
					dexterity=8
					constitution=15
					intelligence=2
					wisdom=8
					charisma=7
					movement=5
					hp=54
					ac=4
					thac0=15
					apr=1
					xpv=1400
					alignment=IDS_OF_SYMBOL (~alignment~ ~NEUTRAL~)
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					morale=12
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~BASILISK~)
					class=IDS_OF_SYMBOL (~class~ ~BASILISK~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN LBASILSK END
			DEFINE_ARRAY skipFiles BEGIN BASILLSU END
			LPF patchCreatureScript STR_VAR script=ja#m2 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN LBASILSK END
			DEFINE_ARRAY files BEGIN BASILLSU END
			LPF patchCreatureScript STR_VAR script=ja#m2su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BASILLSU~) BEGIN 
				LPF patchCreature
					INT_VAR
						hp=54
						thac0=15
						xpv=0
						saveDeath=11
						saveWand=13
						savePolymorph=12
						saveBreath=13
						saveSpell=14
						summon=1
				END
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END