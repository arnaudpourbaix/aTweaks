ACTION_FOR_EACH ~file~ IN
	BDWOLFVA
	P#WOLF04
	WOLFVA
	DW#ULCWO
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_CRE_EFFECTS
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~WOLFVA1~
			REMOVE_CRE_ITEM ~BDWOLFVA~
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~RING95~
			REPLACE_CRE_ITEM ~ja#1m21~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~ja#2m21~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON2~ 
			REPLACE_CRE_ITEM ~ja#3m21~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON3~ 
			ADD_CRE_ITEM ~ja#4m21~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			DEFINE_ARRAY notEnforceFiles BEGIN DW#ULCWO END
			LPF patchCreature
				INT_VAR
					level1=6
					strength=18
					dexterity=13
					constitution=9
					intelligence=6
					wisdom=12
					charisma=7
					movement=19
					hp=52
					ac=2
					thac0=13
					apr=1
					xpv=2000
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL_EVIL~)
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					morale=14
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~WOLF~)
					class=IDS_OF_SYMBOL (~class~ ~WOLF_VAMPIRIC~)
					gender=IDS_OF_SYMBOL (~gender~ ~MALE~)
					sex=IDS_OF_SYMBOL (~gender~ ~MALE~)
					enforce=1
				STR_VAR
					notEnforceFiles
			END
			DEFINE_ARRAY removeScripts BEGIN DW#GPSHM VAMPWOLF END
			LPF patchCreatureScript STR_VAR script=ja#m21 removeScripts END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
