ACTION_FOR_EACH ~file~ IN
	BDHELP03
	BDSPID7L
	BPSPID03
	PLYSPID
	SPIDSW
	SPIDSW01
	SPIDSWSU
	BPSPID01
	GV#SPID
	WISPID01
	WISPID02
	WISPID03
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~BDHELP03~ AND NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDSWSU~ AND NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~PLYSPID~ AND NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~WISPID03~ BEGIN
				REMOVE_CRE_EFFECTS
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~SPIDSW1~
			REMOVE_CRE_ITEM ~ANTIWEB~
			REMOVE_CRE_ITEM ~SPIDSWSU~
			REMOVE_CRE_ITEM ~WISPIDSW~
			REPLACE_CRE_ITEM ~ja#1m59~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~ja#5m59~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ 
			REPLACE_CRE_ITEM ~ja#4m59~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			ADD_CRE_ITEM ~ja#i14~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~ja#1m59~ #0 ~innate~ (1)
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=5
					strength=16
					dexterity=18
					constitution=14
					intelligence=9
					wisdom=14
					charisma=4
					movement=5
					hp=45
					ac=7
					thac0=15
					apr=1
					xpv=2000
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					morale=13
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SPIDER~)
					class=IDS_OF_SYMBOL (~class~ ~SPIDER_SWORD~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					enforce=1
					perfect2weapon=1
			END
			DEFINE_ARRAY removeScripts BEGIN DW1MELMO DW#GPSHM DW#SPIDS BPSIGHT BPASIGHT END
			DEFINE_ARRAY skipFiles BEGIN BDHELP03 SPIDSWSU PLYSPID END
			LPF patchCreatureScript STR_VAR script=ja#m59 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN DW1MELMO DW#GPSHM DW#SPIDS BPSIGHT BPASIGHT END
			DEFINE_ARRAY files BEGIN BDHELP03 SPIDSWSU END
			LPF patchCreatureScript STR_VAR script=ja#m59su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDHELP03~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~SPIDSWSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~PLYSPID~) BEGIN 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~WISPID03~) BEGIN 
				REPLACE_CRE_ITEM ~ja#5m59~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
				REMOVE_MEMORIZED_SPELLS
				ADD_MEMORIZED_SPELL ~ja#2m59~ #0 ~innate~ (1)
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
