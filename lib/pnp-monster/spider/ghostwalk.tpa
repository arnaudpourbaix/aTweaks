ACTION_FOR_EACH ~file~ IN
	C#LCCENS
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_CRE_EFFECTS
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~SPIDPH1~
			REMOVE_CRE_ITEM ~ANTIWEB~
			REMOVE_CRE_ITEM ~GHOST2~
			REPLACE_CRE_ITEM ~ja#1m58~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~ja#2m58~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~ja#i14~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=14
					strength=15
					dexterity=20
					constitution=17
					intelligence=9
					wisdom=14
					charisma=8
					movement=12
					hp=139
					ac=10
					thac0=7
					apr=2
					xpv=5000
					alignment=IDS_OF_SYMBOL (~align~ ~CHAOTIC_EVIL~)
					saveDeath=5
					saveWand=7
					savePolymorph=6
					saveBreath=5
					saveSpell=8
					morale=13
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SPIDER~)
					class=IDS_OF_SYMBOL (~class~ ~SPIDER_WRAITH~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN INITDLG C#LCCENS END
			LPF patchCreatureScript STR_VAR script=ja#m58 removeScripts END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
