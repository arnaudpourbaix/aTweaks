			END
			DEFINE_ARRAY removeScripts BEGIN BDENSHTV BDNONIN DW1MELMO DW#GPSHM DW#SPIDG BPSIGHT BPASIGHT DVMELEE END
			DEFINE_ARRAY skipFiles BEGIN BDSPIDER END
			LPF patchCreatureScript STR_VAR script=ja#m62 skipFiles removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDSPIDER~) BEGIN 
