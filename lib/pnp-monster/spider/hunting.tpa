		WRITE_SHORT 0xa2 33
		WRITE_LONG 0x98 1
	END
	LPF ADD_EFFECT INT_VAR opcode=25 target=2 parameter1=40 parameter2=3 duration=600 probability1=100 savingthrow=4 savebonus="2" special=6 END

ACTION_FOR_EACH ~file~ IN
	D5SMSPID
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~D5SMSPID~ BEGIN
				REMOVE_CRE_EFFECTS
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~D5SMSPID~
			REMOVE_CRE_ITEM ~ANTIWEB~
			REPLACE_CRE_ITEM ~ja#1m65~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~ja#i14~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~ja#1m65~ #0 ~innate~ (1)
			LPF clear_proficiencies END
			LPF seeInvisible_immunity END
			LPF patchCreature
				INT_VAR
					level1=3
					strength=14
					dexterity=16
					constitution=12
					intelligence=10
					wisdom=11
					charisma=4
					movement=6
					hp=27
					ac=6
					thac0=17
					apr=1
					xpv=650
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					morale=13
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SPIDER~)
					class=IDS_OF_SYMBOL (~class~ ~SPIDER_GIANT~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN DW1MELMO END
			DEFINE_ARRAY skipFiles BEGIN D5SMSPID END
			LPF patchCreatureScript STR_VAR script=ja#m65 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN DW1MELMO END
			DEFINE_ARRAY files BEGIN D5SMSPID END
			LPF patchCreatureScript STR_VAR script=ja#m65su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~D5SMSPID~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END