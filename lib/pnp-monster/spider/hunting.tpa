// Leap
CREATE SPL "ja#1m65"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~ja#1m65.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@4038)
	WRITE_SHORT 0x1c 4
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI305C~ #8
	SAY UNIDENTIFIED_DESC ~
Leaps horizontally as far as 30 feet.~
	LPF ADD_EFFECT INT_VAR opcode=172 target=1 global=1 power=1 timing=1 probability1=100 STR_VAR resource="ja#1m65" END
	LPF ADD_EFFECT INT_VAR opcode=171 target=1 global=1 power=1 timing=4 duration=6 probability1=100 STR_VAR resource="ja#1m65" END
	LPF ADD_SPELL_HEADER INT_VAR type=1 location=4 target=1 range=30 STR_VAR icon="SPWI305B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=235 target=1 power=1 parameter1=150 parameter2=3 duration=2 probability1=100 END
	
