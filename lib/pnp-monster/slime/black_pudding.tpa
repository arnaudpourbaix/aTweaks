			END
			DEFINE_ARRAY removeScripts BEGIN DW1RANMO BDPUDDBL END
			LPF patchCreatureScript STR_VAR script=ja#m47 slot=General removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ja#blpud~) BEGIN 
				WRITE_LONG 0x14 1000 // xpv
				WRITE_SHORT 0x24 50 // hp
				WRITE_SHORT 0x26 50 // hp
				REMOVE_MEMORIZED_SPELLS
			END
