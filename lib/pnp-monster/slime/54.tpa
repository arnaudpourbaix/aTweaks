			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#FPWP2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#FPWPU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ja#whpud~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
