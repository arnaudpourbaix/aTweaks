// Generated file (don't edit)

COMPILE ~%MOD_FOLDER%/lib/pnp-monster/slime/ja#m54.baf~

// Split
CREATE SPL "ja#1m54"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~ja#1m54.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@4019)
	WRITE_SHORT 0x1c 4
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI212C~ #8
	SAY UNIDENTIFIED_DESC ~Lightning bolts and blows from weapons divide them into smaller puddings, each able to attack exactly as the original pudding.
Because puddings do not use all of their mouth openings (which cover their exposed surfaces), the smallest pudding does the same damage as the largest.~
	LPF ADD_SPELL_HEADER INT_VAR type=3 location=4 target=5 STR_VAR icon="SPWI212B" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=215 target=2 power=1 parameter2=1 timing=1 probability1=100 STR_VAR resource="BDGOOYAA" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=67 target=2 power=1 parameter2=3 timing=1 probability1=100 STR_VAR resource="ja#whpud" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=67 target=2 power=1 parameter2=3 timing=1 probability1=100 STR_VAR resource="ja#whpud" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=168 target=2 power=1 timing=1 probability1=100 END
	
CREATE ITM "ja#1m54"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@4024)
	WRITE_LONG 0xc RESOLVE_STR_REF(@4024)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~IJELLY~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(~Pseudopod

Acid damage: 7D4
Speed Factor: 4
Enchantment: 3
Range: 5 feet~)
	WRITE_LONG 0x60 3
COPY_EXISTING ~ja#1m54.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IJELLY~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 5
		WRITE_BYTE 0x84 4
		WRITE_SHORT 0x9c (IDS_OF_SYMBOL (~projectl~ ~ACIDBLMU~)) + 1
		WRITE_SHORT 0xa0 100
	END
	LPF ADD_EFFECT INT_VAR opcode=12 target=2 parameter2=65536 probability1=100 dicenumber=7 dicesize=4 END

COPY_EXISTING ~AC#FPWPU.cre~ ~override/ja#whpud.cre~
ACTION_FOR_EACH ~file~ IN
	AC#FPWP2
	AC#FPWPU
	ja#whpud
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			WRITE_LONG 0x8 RESOLVE_STR_REF(@4036)
			WRITE_LONG 0xc RESOLVE_STR_REF(@4036)
			PATCH_IF NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~ja#whpud~ BEGIN
				REMOVE_CRE_EFFECTS
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~IMMUNE1~
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~AC#FPWPU~
			ADD_CRE_ITEM ~ja#2m47~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#1m54~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~ja#i8~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#i3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_MEMORIZED_SPELL ~ja#1m54~ #0 ~innate~ (1)
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=9
					strength=16
					dexterity=5
					constitution=16
					intelligence=1
					wisdom=6
					charisma=1
					movement=7
					hp=108
					ac=8
					thac0=11
					apr=1
					xpv=1400
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					saveDeath=8
					saveWand=10
					savePolymorph=9
					saveBreath=9
					saveSpell=11
					morale=12
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SLIME~)
					class=IDS_OF_SYMBOL (~class~ ~GREY_OOZE~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					animation=IDS_OF_SYMBOL (~animate~ ~GRAY_OOZE~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN DW1RANMO END
			LPF patchCreatureScript STR_VAR script=ja#m54 removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ja#whpud~) BEGIN 
				WRITE_LONG 0x14 700 // xpv
				WRITE_SHORT 0x24 45 // hp
				WRITE_SHORT 0x26 45 // hp
				REMOVE_MEMORIZED_SPELLS
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END