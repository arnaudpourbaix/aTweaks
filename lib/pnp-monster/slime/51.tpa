			PATCH_DEFINE_ARRAY skipFiles BEGIN JELLGRSU JELLGRSU X#JELLY X#SLIME END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles script=ja#m51 END
			// Assigning ja#m51su
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#MG29 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#GPSHM DW#GPSHT dw1melbe DW1MELGE DW#PRSHT DW1RANGE dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT TUTU_SCR WTASIGHT WDASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN JELLGRSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts script=ja#m51su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~JELLGRSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~X#JELLY~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~X#SLIME~) BEGIN 
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END