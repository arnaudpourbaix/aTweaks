// Green Slime traits
CREATE ITM "ja#1m51"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10639)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10639)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10640)
COPY_EXISTING ~ja#1m51.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
	END
	LPF magic_immunity END
	LPF physicalDamage_immunity END

// Pseudopod
CREATE ITM "ja#2m51"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10233)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10233)
	WRITE_ASCII 0x3a ~IJELLY~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10641)
COPY_EXISTING ~ja#2m51.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IJELLY~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 5
		WRITE_BYTE 0x84 4
		WRITE_SHORT 0x8e 2
		WRITE_SHORT 0x9c (IDS_OF_SYMBOL (~projectl~ ~ACIDBLMU~)) + 1
	WRITE_SHORT 0xa0 100
	WRITE_LONG 0x98 1
	LPF ADD_EFFECT INT_VAR opcode=12 target=2 parameter2=65536 probability1=100 dicesize=4 dicenumber=1 END
	END

ACTION_FOR_EACH ~file~ IN
	JELLGRSU
	JELLYGR
	JELLYGR2
	X#JELLY
	X#SLIME
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~JELLGRSU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JELLYGR~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JELLYGR2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~X#JELLY~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~X#SLIME~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~JELLGR1~
			REMOVE_CRE_ITEM ~JELLGRSU~
			ADD_CRE_ITEM ~ja#1m51~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#2m51~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~ja#i13~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#i3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=65
					hp=20
					ac=9
					thac0=19
					apr=1
					saveDeath=14
					saveWand=16
					savePolymorph=15
					saveBreath=17
					saveSpell=17
					level1=2
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=4
					intelligence=1
					wisdom=3
					dexterity=12
					constitution=8
					charisma=1
					morale=10
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SLIME~)
					class=IDS_OF_SYMBOL (~class~ ~GREEN_SLIME~)
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					movement=0
					enforce=1
			END
			// Assigning ja#m51
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
