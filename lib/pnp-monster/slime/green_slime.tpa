ACTION_FOR_EACH ~file~ IN
	JELLGRSU
	JELLYGR
	JELLYGR2
	X#JELLY
	X#SLIME
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~JELLGRSU~ AND NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~X#JELLY~ AND NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~X#SLIME~ BEGIN
				REMOVE_CRE_EFFECTS
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~JELLGR1~
			REMOVE_CRE_ITEM ~JELLGRSU~
			REPLACE_CRE_ITEM ~ja#1m51~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~ja#2m51~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~ja#i11~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#i3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=2
					strength=4
					dexterity=12
					constitution=8
					intelligence=1
					wisdom=3
					charisma=1
					movement=0
					hp=20
					ac=9
					thac0=19
					apr=1
					xpv=65
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					morale=10
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SLIME~)
					class=IDS_OF_SYMBOL (~class~ ~GREEN_SLIME~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN BPSIGHT BPASIGHT DW1MELMO END
			DEFINE_ARRAY skipFiles BEGIN JELLGRSU JELLGRSU X#JELLY X#SLIME END
			LPF patchCreatureScript STR_VAR script=ja#m51 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN BPSIGHT BPASIGHT DW1MELMO END
			DEFINE_ARRAY files BEGIN JELLGRSU END
			LPF patchCreatureScript STR_VAR script=ja#m51su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~JELLGRSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~X#JELLY~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~X#SLIME~) BEGIN 
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END