// Gray Ooze
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/slime/ja#m50.baf~

// Gray Ooze traits
CREATE ITM "ja#1m50"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10522)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10522)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10523)
COPY_EXISTING ~ja#1m50.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
	END
	LPF magic_immunity END
	LPF fire_immunity END
	LPF cold_immunity END

// Pseudopod
CREATE ITM "ja#2m50"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10231)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10231)
	WRITE_ASCII 0x3a ~IJELLY~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10524)
COPY_EXISTING ~ja#2m50.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IJELLY~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 5
		WRITE_BYTE 0x84 4
		WRITE_SHORT 0x8e 2
		WRITE_SHORT 0x9c (IDS_OF_SYMBOL (~projectl~ ~ACIDBLMU~)) + 1
	WRITE_SHORT 0xa0 100
	WRITE_LONG 0x98 1
	LPF ADD_EFFECT INT_VAR opcode=12 target=2 parameter2=65536 probability1=100 dicesize=8 dicenumber=2 END
	END

ACTION_FOR_EACH ~file~ IN
	BPJLGR01
	JELLGR
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BPJLGR01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~JELLGR~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~OOZEGR1~
			REMOVE_CRE_ITEM ~DW#OOZEG~
			ADD_CRE_ITEM ~ja#1m50~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#2m50~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~ja#i13~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#i3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=3
					bonusHp=3
					thac0=17
					strength=12
					dexterity=6
					constitution=16
					intelligence=1
					wisdom=6
					charisma=2
					ac=8
					apr=1
					xpv=270
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					morale=10
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SLIME~)
					class=IDS_OF_SYMBOL (~class~ ~GREY_OOZE~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					movement=1
					hp=36
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					enforce=1
			END
			// Assigning ja#m50
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#MG29 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#GPSHM DW#GPSHT dw1melbe DW1MELGE DW#PRSHT DW1RANGE dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT TUTU_SCR WTASIGHT WDASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts script=ja#m50 END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END