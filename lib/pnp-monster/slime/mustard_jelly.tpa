			DEFINE_ARRAY files BEGIN JELLMUSU END
			LPF patchCreatureScript STR_VAR script=ja#m46su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~JELLMUSU~) BEGIN 
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ja#jelmu~) BEGIN 
				WRITE_LONG 0x14 2000 // xpv
				WRITE_SHORT 0x24 49 // hp
				WRITE_SHORT 0x26 49 // hp
				REMOVE_MEMORIZED_SPELLS
				ADD_MEMORIZED_SPELL ~ja#1m46~ #0 ~innate~ (1)
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END