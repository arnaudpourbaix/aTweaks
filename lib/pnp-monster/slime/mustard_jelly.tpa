					resistMagic=10
					thac0=13
					apr=1
					xpv=4000
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					morale=14
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~SLIME~)
					class=IDS_OF_SYMBOL (~class~ ~MUSTARD_JELLY~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN BPSIGHT BPASIGHT DW1RANMO END
			DEFINE_ARRAY skipFiles BEGIN JELLMUSU PLYJELL1 END
			LPF patchCreatureScript STR_VAR script=ja#m46 skipFiles removeScripts END
