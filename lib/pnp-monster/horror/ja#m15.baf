// Init
IF
	Global("JA#INIT","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("JA#INIT","LOCALS",1)
		SetGlobal("JA#COMBAT","LOCALS",0)
		SetGlobal("JA#MELEE","LOCALS",0)
		SetGlobal("JA#DISABLE_SPELLCASTING","LOCALS",0)
		SetGlobalTimer("JA#REST","LOCALS",2400)
END

// Rest (reset everything and heal if applicable)
IF
	Global("JA#INIT","LOCALS",1)
	GlobalTimerExpired("JA#REST","LOCALS")
	!Detect([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("JA#INIT","LOCALS",0)
		Rest()
		ApplySpellRES("JA#HEAL",Myself)
END

// Turn hostile if attacked
IF
	!Allegiance(Myself,ENEMY)
	OR(6)
		AttackedBy([GOODCUTOFF],DEFAULT)
		AttackedBy([CONTROLLED],DEFAULT)
		AttackedBy([CHARMED],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		SpellCastOnMe([CONTROLLED],0)
		SpellCastOnMe([CHARMED],0)
THEN
	RESPONSE #100
		Enemy()
END

// Detect combat
IF
	Global("JA#COMBAT","LOCALS",0)
	See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetGlobal("JA#COMBAT","LOCALS",1)
		Shout(95)
END

// React to shouts
IF
	Global("JA#COMBAT","LOCALS",0)
	Heard([EVILCUTOFF.0.GOLEM],95)
THEN
	RESPONSE #100
		SetGlobal("JA#COMBAT","LOCALS",1)
END

// Do nothing if combat is not started
IF
	Global("JA#COMBAT","LOCALS",0)
	ActionListEmpty()
THEN
	RESPONSE #100
		NoAction()
END

// Magic Missiles
IF
	!GlobalTimerNotExpired("MagicMissiles","LOCALS")
	HaveSpellRES("SPWI112")
	!Range(NearestEnemyOf(Myself),10)
	!GlobalTimerNotExpired("JA#ROUND","LOCALS")
	!CheckStatGT([PC.0.0.MAGE_ALL],0,HELD)
	!StateCheck([PC.0.0.MAGE_ALL],STATE_STUNNED)
	!StateCheck([PC.0.0.MAGE_ALL],STATE_PANIC)
	!StateCheck([PC.0.0.MAGE_ALL],STATE_CONFUSED)
	!StateCheck([PC.0.0.MAGE_ALL],STATE_FEEBLEMINDED)
	!StateCheck([PC.0.0.MAGE_ALL],STATE_SLEEPING)
	!StateCheck([PC.0.0.MAGE_ALL],STATE_HELPLESS)
	!General([PC.0.0.MAGE_ALL],WEAPON)
	!CheckStatGT([PC.0.0.MAGE_ALL],0,SANCTUARY)
	!StateCheck([PC.0.0.MAGE_ALL],STATE_CHARMED)
	!StateCheck([PC.0.0.MAGE_ALL],STATE_REALLY_DEAD)
	See([PC.0.0.MAGE_ALL])
	RandomNumGT(1000,250)
THEN
	RESPONSE #100
		ForceSpellRES("SPWI112",LastSeenBy(Myself))
		SetGlobalTimer("JA#ROUND","LOCALS",6)
		SetGlobalTimer("MagicMissiles","LOCALS",18)
END

