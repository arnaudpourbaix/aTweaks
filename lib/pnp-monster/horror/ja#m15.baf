// Dimension Door
IF
	HaveSpellRES("SPWI402")
	!StateCheck(Myself,STATE_BLIND)
	Range(Player1,180)
THEN
	RESPONSE #100
		ForceSpellRES("SPWI402",{Target}(Myself))
		RemoveSpellRES("SPWI402")
END

