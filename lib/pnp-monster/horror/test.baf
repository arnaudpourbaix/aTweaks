IF
  !GlobalTimerNotExpired("castspell","LOCALS")
  HaveSpell(CLERIC_CHAOS)  // SPPR709.SPL (Chaos)
  !StateCheck(SixthNearest([PC]),STATE_INVISIBLE)
  !CheckStatGT(SixthNearest([PC]),0,SANCTUARY)
  CheckStatLT(Myself,60,SPELLFAILUREPRIEST)
  !CheckSpellState(SixthNearest([PC]),DO_NOT_TARGET_SPELLS)
  See(SixthNearest([PC]))
  !StateCheck(SixthNearest([PC]),STATE_DISABLED)
  OR(3)
      TriggerOverride(SixthNearest([PC]),Range(NearestAllyOf(Myself),15))
      NumInParty(1)
      GlobalTimerNotExpired("targetcompromise","LOCALS")
  OR(2)
      !TriggerOverride(SixthNearest([PC]),StateCheck(NearestAllyOf(Myself),STATE_DISABLED))
      !TriggerOverride(SixthNearest([PC]),StateCheck(SecondNearestAllyOf(Myself),STATE_DISABLED))
  OR(2)
      !TriggerOverride(SixthNearest([PC]),StateCheck(NearestAllyOf(Myself),STATE_DISABLED))
      TriggerOverride(SixthNearest([PC]),Range(SecondNearestAllyOf(Myself),15))
  !StateCheck(SixthNearest([PC]),STATE_CONFUSED)
  !CheckSpellState(SixthNearest([PC]),CHAOTIC_COMMANDS)
  !General(SixthNearest([PC]),UNDEAD)
  !CheckSpellState(SixthNearest([PC]),EXALTATION)
  OR(2)
      !CheckSpellState(SixthNearest([PC]),CONFUSION_IMMUNITY_SEEN)
      !CheckSpellState(SixthNearest([PC]),CONFUSION_IMMUNITY)
  OR(2)
      !CheckStatGT(SixthNearest([PC]),50,RESISTMAGIC)
      GlobalTimerNotExpired("targetcompromise","LOCALS")
  Allegiance(Myself,ENEMY)
  !Allegiance(SixthNearest([PC]),ENEMY)
  !Class(SixthNearest([PC]),SKELETON_WARRIOR)
  CheckStatGT(SixthNearest([PC]),0,SAVEVSSPELL)
THEN
  RESPONSE #200
      ApplySpellRES("dw#mgsee",Myself)  // Armor
      SetGlobalTimer("castspell","LOCALS",ONE_ROUND)
      Spell(SixthNearest([PC]),CLERIC_CHAOS)  // SPPR709.SPL (Chaos)
  RESPONSE #100
      Continue()
END

