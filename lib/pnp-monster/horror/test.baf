  !CheckStatGT(NearestEnemyOf(Myself),0,SANCTUARY)
  CheckStatLT(Myself,60,SPELLFAILUREPRIEST)
  !CheckSpellState(NearestEnemyOf(Myself),DO_NOT_TARGET_SPELLS)
  See(NearestEnemyOf(Myself))
  ActionListEmpty()
  !Allegiance(Myself,ENEMY)
  !StateCheck(NearestEnemyOf(Myself),STATE_DISABLED)
  !CheckStatGT(NearestEnemyOf(Myself),0,HELD)
  !Kit(NearestEnemyOf(Myself),UNDEADHUNTER)
  !Kit(NearestEnemyOf(Myself),INQUISITOR)
  !CheckStatGT(NearestEnemyOf(Myself),0,CLERIC_FREE_ACTION)
  OR(2)
      !CheckSpellState(NearestEnemyOf(Myself),HOLD_IMMUNITY_SEEN)
      !CheckSpellState(NearestEnemyOf(Myself),HOLD_IMMUNITY)
  OR(2)
      !CheckStatGT(NearestEnemyOf(Myself),50,RESISTMAGIC)
      GlobalTimerNotExpired("targetcompromise","LOCALS")
  CheckStatGT(NearestEnemyOf(Myself),4,SAVEVSSPELL)
THEN
  RESPONSE #70
      SetGlobalTimer("castspell","LOCALS",ONE_ROUND)
      Spell(NearestEnemyOf(Myself),WIZARD_HOLD_MONSTER)  // SPWI507.SPL (Hold Monster)
  RESPONSE #30
      Continue()
END

