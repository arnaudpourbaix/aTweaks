  HaveSpell(CLERIC_MENTAL_DOMINATION)  // SPPR405.SPL (Mental Domination)
  !StateCheck([PC.0.0.FIGHTER],STATE_NOT_TARGETABLE)
  !CheckStatGT([PC.0.0.FIGHTER],0,SANCTUARY)
  CheckStatLT(Myself,60,SPELLFAILUREPRIEST)
  !CheckSpellState([PC.0.0.FIGHTER],DO_NOT_TARGET_SPELLS)
  See([PC.0.0.FIGHTER])
  !StateCheck([PC.0.0.FIGHTER],STATE_DISABLED)
  !CheckStatGT([PC.0.0.FIGHTER],0,HELD)
  !Kit([PC.0.0.FIGHTER],CAVALIER)
  !Kit([PC.0.0.FIGHTER],INQUISITOR)
  !Race([PC.0.0.FIGHTER],ELF)
  !CheckSpellState([PC.0.0.FIGHTER],CHAOTIC_COMMANDS)
  !General([PC.0.0.FIGHTER],UNDEAD)
  !CheckSpellState([PC.0.0.FIGHTER],ALLIED_AND_SAME_ALIGNMENT_RIGHTEOUS_WRATH_OF_THE_FAITHFUL)
  OR(2)
      !CheckSpellState([PC.0.0.FIGHTER],CHARM_IMMUNITY_SEEN)
      !CheckSpellState([PC.0.0.FIGHTER],CHARM_IMMUNITY)
  !CheckStatGT([PC.0.0.FIGHTER],0,MINORGLOBE)
  OR(2)
      !CheckStatGT([PC.0.0.FIGHTER],50,RESISTMAGIC)
      GlobalTimerNotExpired("targetcompromise","LOCALS")
