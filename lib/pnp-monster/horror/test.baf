  !Allegiance([PC.0.0.LONG_BOW],ENEMY)
  !StateCheck([PC.0.0.LONG_BOW],STATE_DISABLED)
  !CheckStatGT([PC.0.0.LONG_BOW],0,HELD)
  OR(2)
      WeaponEffectiveVs([PC.0.0.LONG_BOW],MAINHAND)
      GlobalTimerNotExpired("seedefences","LOCALS")
  OR(2)
      WeaponCanDamage([PC.0.0.LONG_BOW],MAINHAND)
      GlobalTimerNotExpired("seedefences","LOCALS")
  CheckStatLT([PC.0.0.LONG_BOW],100,RESISTCRUSHING)
  OR(2)
      CheckStatLT([PC.0.0.LONG_BOW],75,RESISTCRUSHING)
      GlobalTimerNotExpired("targetcompromise","LOCALS")
THEN
  RESPONSE #100
      MoveToObject([PC.0.0.LONG_BOW])
END

