// Touch of Tranquility (The touch is automatic for charmed individuals)
IF
	CheckStat(Myself,0,POLYMORPHED)
	!GlobalTimerNotExpired("Touch","LOCALS")
	HaveSpellRES("rr#ftrnq")
	StateCheck(NearestAllyOf(Myself),STATE_CHARMED)
	!See(NearestEnemyOf(Myself))
	!CheckStatGT(NearestAllyOf(Myself),0,HELD)
	!StateCheck(NearestAllyOf(Myself),STATE_STUNNED)
	!StateCheck(NearestAllyOf(Myself),STATE_PANIC)
	!StateCheck(NearestAllyOf(Myself),STATE_CONFUSED)
	!StateCheck(NearestAllyOf(Myself),STATE_FEEBLEMINDED)
	!StateCheck(NearestAllyOf(Myself),STATE_SLEEPING)
	!StateCheck(NearestAllyOf(Myself),STATE_HELPLESS)
	!General(NearestAllyOf(Myself),WEAPON)
	!StateCheck(NearestAllyOf(Myself),STATE_IMPROVEDINVISIBILITY)
	!StateCheck(NearestAllyOf(Myself),STATE_INVISIBLE)
	!CheckStatGT(NearestAllyOf(Myself),0,SANCTUARY)
	!StateCheck(NearestAllyOf(Myself),STATE_REALLY_DEAD)
	See(NearestAllyOf(Myself))
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("Touch","LOCALS",6)
		EquipMostDamagingMelee()
		MoveToObjectNoInterrupt(LastSeenBy(Myself))
		ForceSpellRES("rr#ftrnq",LastSeenBy(Myself))
		SetInterrupt(TRUE)
END

