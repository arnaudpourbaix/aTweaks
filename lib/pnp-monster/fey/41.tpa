COMPILE ~%MOD_FOLDER%/lib/pnp-monster/fey/ja#m41.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/fey/ja#m41su.baf~

// Stream of acidic enzymes
CREATE SPL "ja#1m41"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~ja#1m41.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10105)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 10
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI211C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10106)
	LPF ADD_SPELL_HEADER INT_VAR type=2 location=4 target=1 range=30 speed=3 projectile=(IDS_OF_SYMBOL (~projectl~ ~acidblob~)) + 1 STR_VAR icon="SPWI211C" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=12 target=2 power=1 parameter2=65536 probability1=100 dicesize=4 dicenumber=8 savingthrow=4 special=256 END
	
	ACTION_FOR_EACH ~file~ IN
	DRYAD
	ja#dryad
	DRY01
	DRYAD01
	DRYAD02
	DRYAD03
	IDRYAD01
	IDRYAD02
	IDRYAD03
	dr01mod
	drmod
	RE_DRYAD
	H_KATREC
	L#APEST
	NTARCHAN
	NTASSAIA
	NTESSILA
	NTLUCRET
	NTMILEA
	NTPAULIA
	NTTAMAEL
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~DRYAD~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ja#dryad~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DRY01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DRYAD01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DRYAD02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DRYAD03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~IDRYAD01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~IDRYAD02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~IDRYAD03~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~dr01mod~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~drmod~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RE_DRYAD~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~H_KATREC~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~L#APEST~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTARCHAN~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTASSAIA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTESSILA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTLUCRET~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTMILEA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTPAULIA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NTTAMAEL~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			ADD_CRE_ITEM ~ja#i5~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~ja#1m41~ #0 ~innate~ (1)
			LPF clear_proficiencies END
			SET_BG2_PROFICIENCY ~PROFICIENCYDAGGER~ 2
			LPF patchCreature
				INT_VAR
					level1=2
					strength=10
					dexterity=12
					constitution=11
					intelligence=14
					wisdom=15
					charisma=18
					ac=9
					apr=1
					xpv=975
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					morale=12
					general=IDS_OF_SYMBOL (~general~ ~HUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~FAIRY~)
					class=IDS_OF_SYMBOL (~class~ ~FAIRY_DRYAD~)
					gender=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					sex=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					movement=10
					hp=16
					thac0=19
					saveDeath=14
					saveWand=16
					savePolymorph=15
					saveBreath=17
					saveSpell=17
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN DRYAD BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDGRSHTV BDNONIN BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#GPSHM DW#GPSHT DW1MELGE DW#PRSHT dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT WTASIGHT WDASIGHT wtrunsgt END
			DEFINE_ARRAY skipFiles BEGIN ja#dryad END
			LPF patchCreatureScript STR_VAR script=ja#m41 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN DRYAD BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDGRSHTV BDNONIN BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#GPSHM DW#GPSHT DW1MELGE DW#PRSHT dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT WTASIGHT WDASIGHT wtrunsgt END
			DEFINE_ARRAY files BEGIN ja#dryad END
			LPF patchCreatureScript STR_VAR script=ja#m41su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ja#dryad~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~DRYAD~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~L#APEST~) BEGIN 
				WRITE_BYTE 0x273 IDS_OF_SYMBOL (~class~ ~INNOCENT~) // class
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END