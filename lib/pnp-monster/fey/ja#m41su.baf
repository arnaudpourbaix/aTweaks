	!StateCheck(Nearest([PC]),STATE_CONFUSED)
	!StateCheck(Nearest([PC]),STATE_FEEBLEMINDED)
	!StateCheck(Nearest([PC]),STATE_SLEEPING)
	!StateCheck(Nearest([PC]),STATE_HELPLESS)
	See(Nearest([PC]))
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		ForceSpellRES("ja#1m41",Nearest([PC]))
		RemoveSpellRES("ja#1m41")
		SetGlobalTimer("JA#ROUND","LOCALS",6)
		SetInterrupt(TRUE)
END

