// Generated file (don't edit)

// Nymph
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/fey/ja#m44.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/fey/ja#m44su.baf~

// Nymph traits
CREATE ITM "ja#1m44"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10325)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10325)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10326)
COPY_EXISTING ~ja#1m44.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
	END
	LPF magicResistance_resistance END

ACTION_FOR_EACH ~file~ IN
	BDNYMP01
	HGNYMPH
	BDNYMP02
	NYMPHSU
	NYMPHSUM
	DW#NYMSU
	ABELA
	WQXNYM
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDNYMP01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~HGNYMPH~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDNYMP02~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NYMPHSU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~NYMPHSUM~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~DW#NYMSU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~ABELA~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~WQXNYM~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~DAGG01~
			REMOVE_CRE_ITEM ~B1-6~
			ADD_CRE_ITEM ~ja#1m44~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~ja#i5~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~ja#2f8~ #0 ~innate~ (1) // Dimension Door
			ADD_MEMORIZED_SPELL ~ja#6f8~ #0 ~innate~ (1) // Animal Friendship
			ADD_MEMORIZED_SPELL ~ja#9f8~ #0 ~innate~ (1) // Blinding Beauty
			ADD_MEMORIZED_SPELL ~SPPR103~ #0 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR101~ #0 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR105~ #0 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR202~ #1 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR204~ #1 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR302~ #2 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR319~ #2 ~priest~ (1) 
			ADD_MEMORIZED_SPELL ~SPPR410~ #3 ~priest~ (1) 
			LPF clear_proficiencies END
			LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete=206 END
			LPF patchCreature
				INT_VAR
					level1=7
					hp=24
					thac0=17
					saveDeath=10
					saveWand=14
					savePolymorph=13
					saveBreath=16
					saveSpell=15
					strength=10
					dexterity=17
					constitution=12
					intelligence=16
					wisdom=12
					charisma=19
					ac=10
					apr=0
					xpv=1400
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL_GOOD~)
					morale=7
					general=IDS_OF_SYMBOL (~general~ ~HUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~FAIRY~)
					class=IDS_OF_SYMBOL (~class~ ~DRUID~)
					gender=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					sex=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					movement=10
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN BDNYMP01 NYMPH BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDGRSHTV BDNONIN BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#GPSHM DW#GPSHT DW1MELGE DW#PRSHT dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT WTASIGHT WDASIGHT wtrunsgt END
			DEFINE_ARRAY skipFiles BEGIN NYMPHSU NYMPHSUM DW#NYMSU END
			LPF patchCreatureScript STR_VAR script=ja#m44 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN BDNYMP01 NYMPH BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDGRSHTV BDNONIN BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#GPSHM DW#GPSHT DW1MELGE DW#PRSHT dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT WTASIGHT WDASIGHT wtrunsgt END
			DEFINE_ARRAY files BEGIN NYMPHSU NYMPHSUM DW#NYMSU END
			LPF patchCreatureScript STR_VAR script=ja#m44su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~NYMPHSU~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~NYMPHSUM~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~DW#NYMSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDNYMP02~) BEGIN 
				WRITE_BYTE 0x27b IDS_OF_SYMBOL (~align~ ~NEUTRAL_EVIL~) // alignment
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END