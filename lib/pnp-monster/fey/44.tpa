			PATCH_DEFINE_ARRAY skipFiles BEGIN NYMPHSU NYMPHSUM DW#NYMSU END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles script=ja#m44 END
			// Assigning ja#m44su
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN BDNYMP01 NYMPH BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#MG29 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#GPSHM DW#GPSHT dw1melbe DW1MELGE DW#PRSHT DW1RANGE dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT TUTU_SCR WTASIGHT WDASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN NYMPHSU NYMPHSUM DW#NYMSU END
