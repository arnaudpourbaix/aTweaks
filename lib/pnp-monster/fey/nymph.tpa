					saveWand=14
					savePolymorph=13
					saveBreath=16
					saveSpell=15
					morale=7
					moraleBreak=2
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~HUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~FAIRY~)
					class=IDS_OF_SYMBOL (~class~ ~DRUID~)
					gender=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					sex=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN BDENSHTV BDNYMP01 NYMPH END
			DEFINE_ARRAY skipFiles BEGIN NYMPHSU NYMPHSUM DW#NYMSU END
			LPF patchCreatureScript STR_VAR script=ja#m44 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN BDENSHTV BDNYMP01 NYMPH END
			DEFINE_ARRAY files BEGIN NYMPHSU NYMPHSUM DW#NYMSU END
			LPF patchCreatureScript STR_VAR script=ja#m44su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~NYMPHSU~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~NYMPHSUM~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~DW#NYMSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDNYMP02~) BEGIN 
				WRITE_BYTE 0x27b IDS_OF_SYMBOL (~align~ ~NEUTRAL_EVIL~) // alignment
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
