			ADD_MEMORIZED_SPELL ~ja#5m44~ #1 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~ja#6m44~ #2 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~ja#7m44~ #2 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~ja#8m44~ #3 ~priest~ (1)
			LPF clear_proficiencies END
			LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete=206 END
			LPF patchCreature
				INT_VAR
					level1=7
					strength=10
					dexterity=17
					constitution=12
					intelligence=16
					wisdom=12
					charisma=19
					movement=10
					hp=24
					ac=9
					thac0=17
					apr=0
					xpv=1400
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL_GOOD~)
