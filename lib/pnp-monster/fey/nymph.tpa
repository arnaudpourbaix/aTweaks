		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~NYMPHSU~ AND NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~NYMPHSUM~ AND NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~DW#NYMSU~ AND NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~BDNYMP02~ BEGIN
				REMOVE_CRE_EFFECTS
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~DAGG01~
			REMOVE_CRE_ITEM ~B1-6~
			ADD_CRE_ITEM ~ja#1m44~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~ja#i5~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~rr#fafrn~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~rr#fbbea~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~rr#ddoo2~ #0 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~ja#1m44~ #0 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~ja#2m44~ #0 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~ja#3m44~ #0 ~priest~ (1)
