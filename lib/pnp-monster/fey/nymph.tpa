ACTION_FOR_EACH ~file~ IN
	BDNYMP01
	HGNYMPH
	BDNYMP02
	NYMPHSU
	NYMPHSUM
	DW#NYMSU
	ABELA
	WQXNYM
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~DAGG01~
			REMOVE_CRE_ITEM ~B1-6~
			ADD_MEMORIZED_SPELL ~SPPR103~ #0 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~SPPR101~ #0 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~SPPR202~ #1 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~SPPR204~ #1 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~SPPR302~ #2 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~SPPR319~ #2 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~SPPR410~ #3 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~SPPR402~ #3 ~priest~ (1)
			ADD_MEMORIZED_SPELL ~rr#fafrn~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~rr#ddoor~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~rr#fbbea~ #0 ~innate~ (1)
			LPF clear_proficiencies END
			LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete=206 END
			LPF patchCreature
				INT_VAR
					level1=7
					strength=10
					dexterity=17
					constitution=12
					intelligence=16
					wisdom=12
					charisma=19
					movement=10
					hp=24
					ac=9
					resistMagic=50
					thac0=17
					apr=0
					xpv=1400
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL_GOOD~)
					saveDeath=10
					saveWand=14
					savePolymorph=13
					saveBreath=16
					saveSpell=15
					morale=7
					moraleBreak=2
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~HUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~FAIRY~)
					class=IDS_OF_SYMBOL (~class~ ~DRUID~)
					gender=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					sex=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN BDENSHTV BDNYMP01 END
			LPF patchCreatureScript STR_VAR script=ja#m44 removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDNYMP02~) BEGIN 
				WRITE_BYTE 0x27b IDS_OF_SYMBOL (~align~ ~NEUTRAL_EVIL~) // alignment
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END