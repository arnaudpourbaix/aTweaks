// Dimension Door
IF
	!StateCheck(Myself,STATE_SILENCED)
	!GlobalTimerNotExpired("JA#ROUND","LOCALS")
	HaveSpellRES("rr#ddoo2")
	OR(2)
		Range(NearestEnemyOf(Myself),10)
		AttackedBy([ANYONE],DEFAULT)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("JA#ROUND","LOCALS",6)
		CreateCreatureOffscreen("RR#TRAT",0)
		ForceSpellRES("rr#ddoo2","RR#TRAT")
		Wait(1)
		SetInterrupt(TRUE)
END

// Call Woodland Beeings
IF
	!StateCheck(Myself,STATE_SILENCED)
	!GlobalTimerNotExpired("JA#ROUND","LOCALS")
	HaveSpell(CLERIC_CALL_WOODLAND_BEINGS)
	AreaType(OUTDOOR)
	RandomNumGT(800,240)
THEN
	RESPONSE #100
		SetGlobalTimer("JA#ROUND","LOCALS",6)
		ForceSpell(Myself,CLERIC_CALL_WOODLAND_BEINGS)
		RemoveSpell(CLERIC_CALL_WOODLAND_BEINGS)
END

