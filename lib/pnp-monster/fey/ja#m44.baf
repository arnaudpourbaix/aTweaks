// Animal Friendship
IF
	HaveSpellRES("rr#fafrn")
	RandomNumGT(807,242)
	!GlobalTimerNotExpired("JA#ROUND","LOCALS")
	!General(NearestEnemyOfType([0.ANIMAL]),WEAPON)
	!StateCheck(NearestEnemyOfType([0.ANIMAL]),STATE_IMPROVEDINVISIBILITY)
	!StateCheck(NearestEnemyOfType([0.ANIMAL]),STATE_INVISIBLE)
	!CheckStatGT(NearestEnemyOfType([0.ANIMAL]),0,SANCTUARY)
	!StateCheck(NearestEnemyOfType([0.ANIMAL]),STATE_CHARMED)
	!StateCheck(NearestEnemyOfType([0.ANIMAL]),STATE_REALLY_DEAD)
	See(NearestEnemyOfType([0.ANIMAL]))
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("JA#ROUND","LOCALS",6)
		ForceSpellRES("rr#fafrn",NearestEnemyOfType([0.ANIMAL]))
		SetInterrupt(TRUE)
END

