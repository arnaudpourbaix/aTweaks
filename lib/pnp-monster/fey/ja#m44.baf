		SetInterrupt(TRUE)
END

// Cure Light Wounds
IF
	!StateCheck(Myself,STATE_SILENCED)
	!GlobalTimerNotExpired("JA#ROUND","LOCALS")
	HaveSpell(CLERIC_CURE_LIGHT_WOUNDS)
	HPPercentLT(Myself,75)
	RandomNumGT(808,243)
THEN
	RESPONSE #100
		SetGlobalTimer("JA#ROUND","LOCALS",6)
		ForceSpell(Myself,CLERIC_CURE_LIGHT_WOUNDS)
		RemoveSpell(CLERIC_CURE_LIGHT_WOUNDS)
END

// Run away from enemies
IF
	Range(NearestEnemyOf(Myself),20)
THEN
	RESPONSE #100
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
END

// Track players if allegiance is not GOODCUTOFF
IF
	!Allegiance(Myself,GOODCUTOFF)
	!StateCheck(Myself,STATE_BLIND)
	InMyArea(Player1)
	Range(Player1,150)
	OR(3)
		HaveSpellRES("SPPR302")
		HaveSpellRES("SPPR204")
		HaveSpellRES("SPPR319")
	!StateCheck(Player1,STATE_IMPROVEDINVISIBILITY)
	!StateCheck(Player1,STATE_INVISIBLE)
	!CheckStatGT(Player1,0,SANCTUARY)
	!StateCheck(Player1,STATE_CHARMED)
	!StateCheck(Player1,STATE_REALLY_DEAD)
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

