COMPILE ~%MOD_FOLDER%/lib/pnp-monster/fey/ja#m42.baf~

COPY_EXISTING "ENTANG2.pro" ~override/RR#FENTG.pro~
	READ_SHORT 0x08 type
	PATCH_IF (%type% = 1) BEGIN
		INSERT_BYTES 0x100 0x100
	END
	WRITE_LONG 0x200 64
ADD_PROJECTILE ~override/RR#FENTG.pro~ ~Hamadryad Entangle~

CREATE EFF "RR#FENTG"
	WRITE_LONG 0x10 206
	WRITE_LONG 0x14 2
	WRITE_LONG 0x24 1
	WRITE_SHORT 0x2c 100
	WRITE_ASCII 0x30 ~RR#FENTG~ #8

