ACTION_FOR_EACH ~file~ IN
	DRYADHA
	VAELASA
	WQXHAMA
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ANTIWEB~
			ADD_CRE_ITEM ~ja#i6~ #0 #0 #0 ~UNDROPPABLE~ ~AMULET~ 
			ADD_MEMORIZED_SPELL ~rr#fchrm~ #0 ~innate~ (3)
			ADD_MEMORIZED_SPELL ~rr#fspkp~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~rr#ddoor~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~RR#FENTG~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~rr#fafrn~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~rr#fdsnr~ #0 ~innate~ (1)
			LPF clearProficiencies END
			SET_BG2_PROFICIENCY ~PROFICIENCYDAGGER~ 2
			LPF patchCreature
				INT_VAR
					level1=4
					strength=10
					dexterity=18
					constitution=12
					intelligence=14
					wisdom=14
					charisma=18
					movement=13
					hp=32
					ac=7
					resistMagic=75
					thac0=17
					apr=1
					xpv=1400
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					morale=12
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~HUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~FAIRY~)
					class=IDS_OF_SYMBOL (~class~ ~FAIRY_DRYAD~)
					gender=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					sex=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN HAMA DW1MELGE END
			LPF patchCreatureScript STR_VAR script=ja#m42 removeScripts END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END