ACTION_FOR_EACH ~file~ IN
	DRYADHA
	ja#hama
	VAELASA
	WQXHAMA
	WIDRYAD1
	WIDRYAD2
	BDHAMADC
	BDHAMADR
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~ja#hama~ AND NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~WIDRYAD1~ AND NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~WIDRYAD2~ AND NOT "%SOURCE_RES%" STRING_EQUAL_CASE ~BDHAMADC~ BEGIN
				REMOVE_CRE_EFFECTS
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ANTIWEB~
			ADD_CRE_ITEM ~ja#1m42~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_CRE_ITEM ~ja#i5~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			ADD_MEMORIZED_SPELL ~rr#fchrm~ #0 ~innate~ (3)
			ADD_MEMORIZED_SPELL ~rr#fspkp~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~rr#ddoor~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~RR#FENTG~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~rr#fafrn~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~rr#fdsnr~ #0 ~innate~ (1)
			LPF clear_proficiencies END
			LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete=189 END
			LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete=206 END
			SET_BG2_PROFICIENCY ~PROFICIENCYDAGGER~ 2
			LPF patchCreature
				INT_VAR
					level1=4
					strength=10
					dexterity=18
					constitution=12
					intelligence=14
					wisdom=14
					charisma=18
					movement=12
					hp=32
					ac=7
					thac0=17
					apr=1
					xpv=1400
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					morale=12
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~HUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~FAIRY~)
					class=IDS_OF_SYMBOL (~class~ ~FAIRY_DRYAD~)
					gender=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					sex=IDS_OF_SYMBOL (~gender~ ~FEMALE~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN HAMA DW1MELGE BDHAMADC END
			DEFINE_ARRAY skipFiles BEGIN ja#hama END
			LPF patchCreatureScript STR_VAR script=ja#m42 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN HAMA DW1MELGE BDHAMADC END
			DEFINE_ARRAY files BEGIN ja#hama END
			LPF patchCreatureScript STR_VAR script=ja#m42su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~ja#hama~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~WIDRYAD1~) OR ("%SOURCE_RES%" STRING_EQUAL_CASE ~WIDRYAD2~) BEGIN 
				WRITE_SHORT 0x24 64 // hp
				WRITE_SHORT 0x26 64 // hp
				WRITE_BYTE 0x52 13 // thac0
				WRITE_BYTE 0x54 10 // saveDeath
				WRITE_BYTE 0x55 12 // saveWand
				WRITE_BYTE 0x56 11 // savePolymorph
				WRITE_BYTE 0x57 12 // saveBreath
				WRITE_BYTE 0x58 13 // saveSpell
				WRITE_BYTE 0x234 8 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDHAMADC~) BEGIN 
				WRITE_BYTE 0x27b IDS_OF_SYMBOL (~align~ ~NEUTRAL_EVIL~) // alignment
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END