// Attack Grabbed enemy
IF
	OR(7)
		!CheckSpellState(NearestEnemyOf(Myself),JA_GRAPPLED)
		General(NearestEnemyOf(Myself),WEAPON)
		StateCheck(NearestEnemyOf(Myself),STATE_INVISIBLE)
		CheckStatGT(NearestEnemyOf(Myself),0,SANCTUARY)
		StateCheck(NearestEnemyOf(Myself),STATE_CHARMED)
		StateCheck(NearestEnemyOf(Myself),STATE_REALLY_DEAD)
		!See(NearestEnemyOf(Myself))
	OR(7)
		!CheckSpellState(SecondNearestEnemyOf(Myself),JA_GRAPPLED)
		General(SecondNearestEnemyOf(Myself),WEAPON)
