COMPILE ~%MOD_FOLDER%/lib/pnp-monster/ankheg/ja#m1.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/ankheg/ja#m1su.baf~

CREATE SPL "ja#1m1"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x28
	WRITE_SHORT 0x68 1
	WRITE_LONG 0x6a 0x9a
	WRITE_SHORT 0x72 1
	WRITE_SHORT 0x82 1
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 10
	WRITE_LONG 0x34 1
	WRITE_SHORT 0x74 4
	WRITE_BYTE 0x7e 1
	WRITE_SHORT 0x80 5
	SAY NAME1 @4001 SAY NAME2 @4001
	SAY UNIDENTIFIED_DESC ~The ankheg can secret acidic digestive enzymes to cause an additional 1d4 points of damage per round until the victim is dissolved (truncated to 4 rounds).~
	LPF ADD_EFFECT
		INT_VAR
			opcode = 206
			target = 2
			parameter1 = 0
			parameter2 = 0
			duration = 24
			probability1 = 100
		STR_VAR
			resource = "ja#1m1"
		END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 142
			target = 2
			parameter1 = 0
			parameter2 = 102
			duration = 24
			probability1 = 100
		END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 12
			target = 2
			parameter1 = 0
			parameter2 = 65536
			probability1 = 100
			dicenumber = 1
			dicesize = 4
		END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 12
			target = 2
			parameter1 = 0
			parameter2 = 65536
			timing = 4
			duration = 6
			probability1 = 100
			dicenumber = 1
			dicesize = 4
		END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 12
			target = 2
			parameter1 = 0
			parameter2 = 65536
			timing = 4
			duration = 12
			probability1 = 100
			dicenumber = 1
			dicesize = 4
		END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 12
			target = 2
			parameter1 = 0
			parameter2 = 65536
			timing = 4
			duration = 18
			probability1 = 100
			dicenumber = 1
			dicesize = 4
		END

CREATE SPL "ja#2m1"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x28
	WRITE_SHORT 0x68 1
	WRITE_LONG 0x6a 0x9a
	WRITE_SHORT 0x72 2
	WRITE_SHORT 0x82 1
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 10
	WRITE_LONG 0x34 1
	WRITE_SHORT 0x74 4
	WRITE_BYTE 0x7e 1
	WRITE_SHORT 0x80 30
	WRITE_SHORT 0x84 3
	SAY NAME1 @4000 SAY NAME2 @4000
	SAY UNIDENTIFIED_DESC ~The ankheg can squirt a stream of acidic enzymes once every six hours to a distance of 30 feet.
A victim struck by the stream of acidic enzymes suffers 8d4 points of damage (half damage if the victim rolls a successful saving throw vs. poison).
It uses this attack technique only when desperate.~
	WRITE_SHORT 0x98 (IDS_OF_SYMBOL (~projectl~ ~acidblob~)) + 1
	LPF ADD_EFFECT
		INT_VAR
			opcode = 12
			target = 2
			parameter1 = 0
			parameter2 = 65536
			probability1 = 100
			dicenumber = 8
			dicesize = 4
			savingthrow = 4
			special = 256
		END

CREATE ITM "ja#m1w1"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x60 2
	WRITE_SHORT 0x74 1
	WRITE_BYTE 0x7e 1
	WRITE_SHORT 0x80 2
	WRITE_SHORT 0x84 3
	WRITE_BYTE 0x88 6
	WRITE_BYTE 0x8a 3
	WRITE_SHORT 0x8e 2
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
COPY_EXISTING ~ja#m1w1.itm~ ~override~
	LPF ADD_EFFECT
		INT_VAR
			opcode = 146
			target = 2
			parameter1 = 0
			parameter2 = 1
			probability1 = 100
		STR_VAR
			resource = "ja#1m1"
		END

CREATE ITM "ja#m1w2"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 2
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x60 2
	WRITE_SHORT 0x74 1
	WRITE_BYTE 0x7e 1
	WRITE_SHORT 0x80 30
	WRITE_SHORT 0x84 3
	WRITE_SHORT 0x86 20
	WRITE_SHORT 0x9c (IDS_OF_SYMBOL (~projectl~ ~acidblob~)) + 1
	WRITE_SHORT 0x38 1
	WRITE_SHORT 0xa4 1
COPY_EXISTING ~ja#m1w2.itm~ ~override~
	LPF ADD_EFFECT
		INT_VAR
			opcode = 146
			target = 2
			parameter1 = 0
			parameter2 = 1
			probability1 = 100
		STR_VAR
			resource = "ja#2m1"
		END
	LPF ADD_EFFECT
		INT_VAR
			opcode = 172
			target = 1
			parameter1 = 0
			parameter2 = 0
			probability1 = 100
		STR_VAR
			resource = "ja#2m1"
		END

ACTION_FOR_EACH ~file~ IN
	ANKHEG
	ANKHEGF
	ANKHEGG
	ANKHEGQ
	ANKHEG01
	bdankh01
	bdankheg
	bdankhsu
	BDNEO
	BPANKHE1
	wiankhe1
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ANKHEG1~
			REMOVE_CRE_ITEM ~ANKHEG2~
			ADD_CRE_ITEM ~ja#m1w1~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~ja#m1w2~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON2~ 
			ADD_MEMORIZED_SPELL ~ja#1m1~ #0 ~innate~ (1)
			ADD_MEMORIZED_SPELL ~ja#2m1~ #0 ~innate~ (1)
			LPF clearProficiencies END
			LPF patchCreature
				INT_VAR
					level1=8
					strength=17
					dexterity=11
					constitution=13
					intelligence=1
					wisdom=13
					charisma=6
					movement=5
					hp=64
					ac=2
					thac0=13
					apr=1
					xpv=975
					alignment=IDS_OF_SYMBOL (~alignment~ ~NEUTRAL~)
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					morale=9
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~ANKHEG~)
					class=IDS_OF_SYMBOL (~class~ ~ANKHEG~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN ANKHEG END
			DEFINE_ARRAY skipFiles BEGIN bdankhsu END
			LPF patchCreatureScript STR_VAR script=ja#m1 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN ANKHEG END
			DEFINE_ARRAY files BEGIN bdankhsu END
			LPF patchCreatureScript STR_VAR script=ja#m1su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~bdankh01~) BEGIN 
				LPF patchCreature
					INT_VAR
						level1=10
						hp=80
						thac0=11
						xpv=1400
						saveDeath=8
						saveWand=10
						savePolymorph=9
						saveBreath=9
						saveSpell=11
				END
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~bdankhsu~) BEGIN 
				LPF patchCreature
					INT_VAR
						hp=64
						thac0=13
						xpv=0
						saveDeath=10
						saveWand=12
						savePolymorph=11
						saveBreath=12
						saveSpell=13
						summon=1
				END
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END