COMPILE ~%MOD_FOLDER%/lib/pnp-monster/ankheg/ja#m1.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/ankheg/ja#m1su.baf~

COPY_EXISTING ~ankheg2.ITM~ ~override/ja#m1.itm~
	LPF set_enchantment INT_VAR enchantment = 0 END
	LPF ALTER_ITMSPL_HEADER
		INT_VAR
			header_type        = 1
			range              = 1
			speed              = 3
			thac0_bonus        = 0
			dicesize           = 6
			dicenumber         = 3
			damage_bonus       = 0
			damage_type        = 2
			projectile         = 1
			flag_strength      = 1
			flag_break         = 0
			flag_strength_damage = 0
			flag_strength_thac0 = 0
			flag_hostile       = 0
			flag_recharge      = 0
			flag_bypass        = 0
	END
	LPF DELETE_EFFECT END
BUT_ONLY IF_EXISTS

ACTION_FOR_EACH ~file~ IN
	ANKHEG
	ANKHEGF
	ANKHEGG
	ANKHEGQ
	ANKHEG01
	bdankh01
	bdankheg
	bdankhsu
	BDNEO
	BPANKHE1
	wiankhe1
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			ADD_CRE_ITEM ~ja#m1~ #0 #0 #0 ~UNDROPPABLE~ ~weapon1~
			LPF patchCreature
				INT_VAR
					level1=8
					strength=21
					dexterity=10
					constitution=17
					intelligence=1
					wisdom=13
					charisma=6
					movement=12
					hp=64
					ac=2
					thac0=13
					apr=1
					xpv=975
					alignment=34
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					morale=9
					moraleBreak=4
					moraleRecovery=15
					general=255
					race=101
					class=101
					gender=4
					sex=4
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN
				ANKHEG
				SHOUT
				WTASIGHT
				wtrunsgt
				DW2MP0GE
				DW2RC2MO
			END
			LPF patchCreatureScript STR_VAR script=ja#m1 removeScripts skipFiles END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~bdankh01~) BEGIN 
				LPF patchCreature
					INT_VAR
						level1=10
						hp=80
						thac0=11
						xpv=1400
						saveDeath=8
						saveWand=10
						savePolymorph=9
						saveBreath=9
						saveSpell=11
				END
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~bdankhsu~) BEGIN 
				DEFINE_ARRAY removeScripts BEGIN
					ja#m1
					ANKHEG
					SHOUT
					WTASIGHT
					wtrunsgt
					DW2MP0GE
					DW2RC2MO
				END
				LPF patchCreatureScript STR_VAR script=ja#m1su removeScripts skipFiles END
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END