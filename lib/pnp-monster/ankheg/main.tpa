ACTION_FOR_EACH ~file~ IN
	BDNEO
	ANKHEG
	ANKHEGF
	ANKHEGG
	ANKHEGQ
	BDANKH01
	BDANKHEG
	BDANKHSU
	BPANKHE1
	WIANKHE1
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ANKHEG1~
			REMOVE_CRE_ITEM ~ANKHEG2~
			REPLACE_CRE_ITEM ~ja#1m1~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~ja#2m1~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON2~ 
			ADD_MEMORIZED_SPELL ~ja#2m1~ #0 ~innate~ (1)
			LPF clear_proficiencies END
			ADD_MEMORIZED_SPELL ~ja#3m1~ #0 ~innate~ (1)
			LPF patchCreature
				INT_VAR
					level1=8
					strength=17
					dexterity=11
					constitution=13
					intelligence=1
					wisdom=13
					charisma=6
					movement=5
					hp=64
					ac=2
					thac0=13
					apr=1
					xpv=975
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					saveDeath=10
					saveWand=12
					savePolymorph=11
					saveBreath=12
					saveSpell=13
					morale=9
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~ANKHEG~)
					class=IDS_OF_SYMBOL (~class~ ~ANKHEG~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN ANKHEG END
			DEFINE_ARRAY skipFiles BEGIN BDANKHSU END
			LPF patchCreatureScript STR_VAR script=ja#m1 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN ANKHEG END
			DEFINE_ARRAY files BEGIN BDANKHSU END
			LPF patchCreatureScript STR_VAR script=ja#m1su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDANKH01~) BEGIN 
				WRITE_LONG 0x14 1400 // xpv
				WRITE_SHORT 0x24 80 // hp
				WRITE_SHORT 0x26 80 // hp
				WRITE_BYTE 0x52 11 // thac0
				WRITE_BYTE 0x54 8 // saveDeath
				WRITE_BYTE 0x55 10 // saveWand
				WRITE_BYTE 0x56 9 // savePolymorph
				WRITE_BYTE 0x57 9 // saveBreath
				WRITE_BYTE 0x58 11 // saveSpell
				WRITE_BYTE 0x234 10 // level1
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BDANKHSU~) BEGIN 
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END