ACTION_FOR_EACH ~file~ IN
	HELMHO
	GLOWTEST
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~HELMHO~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~GLOWTEST~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~HELM08~
			REMOVE_CRE_ITEM ~SHLD18~
			REMOVE_CRE_ITEM ~RING95~
			REMOVE_CRE_ITEM ~BLUN08~
			REMOVE_CRE_ITEM ~FBLADE~
			REMOVE_CRE_ITEM ~PLAT07~
			REMOVE_CRE_ITEM ~HELM13~
			ADD_CRE_ITEM ~ja#1m15~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#2m15~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~ja#3m15~ #0 #0 #0 ~UNDROPPABLE~ ~ARMOR~ 
			REPLACE_CRE_ITEM ~ja#4m15~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_CRE_ITEM ~ja#i2~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			SET_BG2_PROFICIENCY ~PROFICIENCYTWOHANDEDSWORD~ 2
			LPF patchCreature
				INT_VAR
					level1=4
					bonusHp=10
					strength=18
					dexterity=13
					constitution=9
					intelligence=14
					wisdom=10
					charisma=10
					ac=2
					apr=1
					xpv=2000
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					morale=20
					general=IDS_OF_SYMBOL (~general~ ~MONSTER~)
					race=IDS_OF_SYMBOL (~race~ ~GOLEM~)
					class=IDS_OF_SYMBOL (~class~ ~FIGHTER~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					animation=IDS_OF_SYMBOL (~animate~ ~FIGHTER_MALE_HUMAN~)
					hairColor=63
					armorColor=63
					skinColor=63
					majorColor=63
					metalColor=63
					minorColor=63
					leatherColor=63
					movement=10
					hp=52
					thac0=15
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDGRSHTV BDNONIN BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#GPSHM DW#GPSHT DW1MELGE DW#PRSHT dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT WTASIGHT WDASIGHT wtrunsgt END
			LPF patchCreatureScript STR_VAR script=ja#m15 removeScripts END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END