			REPLACE_CRE_ITEM ~ja#3m16~ #0 #0 #0 ~UNDROPPABLE~ ~ARMOR~ 
			REPLACE_CRE_ITEM ~ja#4m16~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_CRE_ITEM ~ja#i2~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			LPF clear_proficiencies END
			SET_BG2_PROFICIENCY ~PROFICIENCYLONGSWORD~ 2
			LPF patchCreature
				INT_VAR
					level1=5
					strength=20
					dexterity=10
					constitution=9
					intelligence=7
					wisdom=11
					charisma=1
