ACTION_FOR_EACH ~file~ IN
	BDMUMM01
	BDMUMMY
	AC#FPMMY
	mummy
	mummy01
	F_MUMMY
	O#LLARU1
	O#LLARU2
	O#LLARU3
	O#LLARU4
	O#LLARU5
	O#LLARU6
	mumx1
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDMUMM01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BDMUMMY~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~AC#FPMMY~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~mummy~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~mummy01~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~F_MUMMY~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLARU1~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLARU2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLARU3~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLARU4~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLARU5~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~O#LLARU6~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~mumx1~ BEGIN
				LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete=292 END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~ring95~
			REMOVE_CRE_ITEM ~immune1~
			REMOVE_CRE_ITEM ~bdmumm01~
			ADD_CRE_ITEM ~ja#1m78~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#2m78~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~ja#i17~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#i3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					xpv=3000
					hp=78
					ac=3
					thac0=13
					apr=1
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					level1=6
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					strength=16
					intelligence=7
					wisdom=10
					dexterity=8
					constitution=15
					charisma=12
					morale=15
					general=IDS_OF_SYMBOL (~general~ ~UNDEAD~)
					race=IDS_OF_SYMBOL (~race~ ~GHOUL~)
					class=IDS_OF_SYMBOL (~class~ ~GHOUL_GHAST~)
					alignment=IDS_OF_SYMBOL (~align~ ~LAWFUL_EVIL~)
					animation=IDS_OF_SYMBOL (~animate~ ~MUMMY~)
					movement=5
					enforce=1
			END
			// Assigning ja#m78
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN bdmumm01 BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#MG29 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#GPSHM DW#GPSHT dw1melbe DW1MELGE DW#PRSHT DW1RANGE dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT TUTU_SCR WTASIGHT WDASIGHT wtrunsgt END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts script=ja#m78 END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
