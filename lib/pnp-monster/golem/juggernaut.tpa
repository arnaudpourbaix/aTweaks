					hp=174
					ac=2
					thac0=3
					apr=2
					xpv=11000
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					saveDeath=3
					saveWand=5
					savePolymorph=4
					saveBreath=4
					saveSpell=6
					morale=16
					moraleBreak=4
					moraleRecovery=15
					general=IDS_OF_SYMBOL (~general~ ~GIANTHUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~GOLEM~)
					class=IDS_OF_SYMBOL (~class~ ~GOLEM_STONE~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					animation=IDS_OF_SYMBOL (~animate~ ~GOLEM_CLAY~)
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN GOLSTO01 GOLIRO01 TOMEGOL4 END
			LPF patchCreatureScript STR_VAR script=ja#m33 removeScripts END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
