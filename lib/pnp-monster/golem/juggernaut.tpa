			ADD_CRE_ITEM ~ja#i2~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#i3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_MEMORIZED_SPELL ~ja#1m33~ #0 ~innate~ (1)
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=18
					strength=22
					dexterity=9
					constitution=20
					intelligence=3
					wisdom=11
					charisma=1
