// Generated file (don't edit)

// Juggernaut Golem
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/golem/ja#m33.baf~
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/golem/ja#m33su.baf~

// Juggernaut Golem traits
CREATE ITM "ja#1m33"
	WRITE_LONG 0x64 0x72
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10453)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10453)
	WRITE_SHORT 0x1c 10
	WRITE_ASCII 0x3a ~IRING15~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10454)
COPY_EXISTING ~ja#1m33.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
	END
	LPF magic_immunity END
	LPF fire_immunity END

// Fists
CREATE ITM "ja#2m33"
	WRITE_LONG 0x64 0x72
	INSERT_BYTES 0x72 0x38
	WRITE_SHORT 0x68 1
	WRITE_SHORT 0x72 1
	WRITE_LONG 0x6a 0xaa
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10190)
	WRITE_LONG 0xc RESOLVE_STR_REF(@10190)
	WRITE_LONG 0x18 64
	WRITE_ASCII 0x3a ~IFIST~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10455)
	WRITE_LONG 0x60 4
COPY_EXISTING ~ja#2m33.itm~ ~override~
	READ_SHORT 0x68 abicount
	PATCH_IF (%abicount% > 0) BEGIN
		WRITE_BYTE 0x74 1
		WRITE_ASCII 0x76 ~IFIST~ #8
		WRITE_BYTE 0x7e 1
		WRITE_SHORT 0x80 2
		WRITE_BYTE 0x84 4
		WRITE_BYTE 0x88 6
		WRITE_BYTE 0x8a 2
		WRITE_SHORT 0x8e 2
	WRITE_SHORT 0x9e 34
	WRITE_SHORT 0xa0 33
	WRITE_SHORT 0xa2 33
	WRITE_LONG 0x98 1
	END

ACTION_FOR_EACH ~file~ IN
	TOMEGOL4
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~TOMEGOL4~ BEGIN
				LPF REMOVE_MOST_CRE_EFFECTS END
			END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~IRONGOL~
			ADD_CRE_ITEM ~ja#1m33~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#2m33~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~ja#i2~ #0 #0 #0 ~UNDROPPABLE~ ~LRING RRING AMULET BELT GLOVES CLOAK~ 
			REPLACE_CRE_ITEM ~ja#i3~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			ADD_MEMORIZED_SPELL ~ja#1f9~ #0 ~innate~ (1) // Charge
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=18
					strength=22
					dexterity=9
					constitution=20
					intelligence=3
					wisdom=11
					charisma=1
					ac=2
					apr=2
					xpv=11000
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					morale=16
					general=IDS_OF_SYMBOL (~general~ ~GIANTHUMANOID~)
					race=IDS_OF_SYMBOL (~race~ ~GOLEM~)
					class=IDS_OF_SYMBOL (~class~ ~GOLEM_STONE~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					animation=IDS_OF_SYMBOL (~animate~ ~GOLEM_CLAY~)
					movement=2
					hp=174
					thac0=3
					saveDeath=3
					saveWand=5
					savePolymorph=4
					saveBreath=4
					saveSpell=6
					enforce=1
			END
			// Assigning ja#m33
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GOLSTO01 GOLIRO01 TOMEGOL4 BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#MG29 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#GPSHM DW#GPSHT dw1melbe DW1MELGE DW#PRSHT DW1RANGE dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT WTASIGHT WDASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY skipFiles BEGIN TOMEGOL4 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR removeScripts skipFiles script=ja#m33 END
			// Assigning ja#m33su
			CLEAR_ARRAY skipFiles
			CLEAR_ARRAY removeScripts
			CLEAR_ARRAY files
			PATCH_DEFINE_ARRAY removeScripts BEGIN GOLSTO01 GOLIRO01 TOMEGOL4 BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDFIGH42 BDFIGH43 BDFMAG01 BDFMAG23 BDGRSHTV BDNONIN BDSHM00 BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#MG29 DW#MG56 DW#MG78 DW#MG84 DW#MG99 DW#MG101 DW#MG102 DW#MG103 DW#MG104 DW#MG105 DW#MG106 DW#MG107 DW#MG108 DW#MG131 DW#MG132 DW#MG137 DW#MG139 DW#GPSHM DW#GPSHT dw1melbe DW1MELGE DW#PRSHT DW1RANGE dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT WTASIGHT WDASIGHT wtrunsgt END
			PATCH_DEFINE_ARRAY files BEGIN TOMEGOL4 END
			LPF patchCreatureScript INT_VAR logging=0 STR_VAR files removeScripts script=ja#m33su END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~TOMEGOL4~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END