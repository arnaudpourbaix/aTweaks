// Generated file (don't edit)

// Kaldran
COMPILE ~%MOD_FOLDER%/lib/pnp-monster/bear/ja#m8.baf~

// Improved stream of frost
COPY_EXISTING "CONECOLD.pro" ~override/ja#1m8.pro~
	READ_SHORT 0x08 type
	PATCH_IF (%type% = 1) BEGIN
		INSERT_BYTES 0x100 0x100
	END
	WRITE_LONG 0x200 80
	WRITE_SHORT 0x204 180
	WRITE_SHORT 0x206 180
ADD_PROJECTILE ~override/ja#1m8.pro~ ~Improved stream of frost~

CREATE SPL "ja#1m8"
	WRITE_LONG 0x64 0x72
COPY_EXISTING ~ja#1m8.SPL~  ~override~
	WRITE_LONG 0x8 RESOLVE_STR_REF(@10115)
	WRITE_SHORT 0x1c 4
	WRITE_BYTE 0x27 10
	WRITE_LONG 0x34 1
	WRITE_ASCII 0x3a ~SPWI523C~ #8
	WRITE_LONG 0x50 RESOLVE_STR_REF(@10116)
	LPF ADD_SPELL_HEADER INT_VAR type=2 location=4 target=4 range=10 projectile=(IDS_OF_SYMBOL (~projectl~ ~ja#1m8~)) + 1 STR_VAR icon="SPWI523C" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=12 target=2 power=1 parameter2=131072 timing=1 probability1=100 dicesize=4 dicenumber=6 savingthrow=2 special=256 END
	LPF ADD_EFFECT INT_VAR header=1 opcode=109 target=2 power=1 parameter1=IDS_OF_SYMBOL (~EA~ ~ANYONE~) parameter2=2 duration=60 probability1=100 savingthrow=4 savebonus="-2" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=142 target=2 power=1 parameter2=13 duration=60 probability1=100 savingthrow=4 savebonus="-2" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=1 probability1=100 savingthrow=4 savebonus="-2" STR_VAR resource="MISC_04A" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=174 target=2 power=1 timing=4 duration=60 probability1=100 savingthrow=4 savebonus="-2" STR_VAR resource="EFF_E03" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=50 target=2 power=1 parameter1="-2786560" parameter2=1310720 timing=1 probability1=100 savingthrow=4 savebonus="-2" END
	LPF ADD_EFFECT INT_VAR header=1 opcode=141 target=2 power=1 parameter2=6 timing=1 probability1=100 savingthrow=4 savebonus="-2" END
	LPF CHANGE_SPELL INT_VAR    renew=1 END
	
	ACTION_FOR_EACH ~file~ IN
	KALDRAN
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_CRE_EFFECTS
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~KALDW1~
			REMOVE_CRE_ITEM ~B1-12~
			REPLACE_CRE_ITEM ~ja#1m7~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~ja#2m7~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			ADD_MEMORIZED_SPELL ~ja#1m8~ #0 ~innate~ (1)
			LPF clear_proficiencies END
			LPF cold_immunity END
			LPF coldSpells_immunity END
			LPF patchCreature
				INT_VAR
					level1=12
					bonusHp=8
					strength=20
					dexterity=10
					constitution=16
					intelligence=10
					wisdom=13
					charisma=7
					ac=6
					apr=3
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					morale=15
					general=IDS_OF_SYMBOL (~general~ ~ANIMAL~)
					race=IDS_OF_SYMBOL (~race~ ~BEAR~)
					class=IDS_OF_SYMBOL (~class~ ~BEAR_POLAR~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					movement=10
					hp=126
					thac0=7
					saveDeath=7
					saveWand=9
					savePolymorph=8
					saveBreath=8
					saveSpell=10
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN kaldran dw1ranmo END
			LPF patchCreatureScript STR_VAR script=ja#m8 removeScripts END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
END