	BDBEARBL
	BEARBL
	BEARBLSU
	PLYBEAR2
	RSBEARBL
	UBDBEAR
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			PATCH_IF "%SOURCE_RES%" STRING_EQUAL_CASE ~BDBEARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BEARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~BEARBLSU~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~PLYBEAR2~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~RSBEARBL~ OR "%SOURCE_RES%" STRING_EQUAL_CASE ~UBDBEAR~ BEGIN
