					class=IDS_OF_SYMBOL (~class~ ~BEAR_BLACK~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					movement=10
					hp=27
					thac0=17
					saveDeath=13
					saveWand=15
					savePolymorph=14
					saveBreath=16
					saveSpell=16
					enforce=1
					perfect2weapon=1
			END
			DEFINE_ARRAY removeScripts BEGIN CBEAR BEAR BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDGRSHTV BDNONIN BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#GPSHM DW#GPSHT DW1MELGE DW#PRSHT dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT WTASIGHT WDASIGHT wtrunsgt END
			DEFINE_ARRAY skipFiles BEGIN BEARBLSU PLYBEAR2 END
			LPF patchCreatureScript STR_VAR script=ja#m4 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN CBEAR BEAR BDANIMN BDENRAGE BDENSHTV BDFIG00 BDFIGH01 BDGRSHTV BDNONIN BDSUM00 BPASIGHT BPSIGHT DVMELEE DW#GPSHM DW#GPSHT DW1MELGE DW#PRSHT dw1ranmo dw1melmo DW2MP0GE DW2RC2MO GENSHT01 HUNTER initdlg SHOUT WTASIGHT WDASIGHT wtrunsgt END
			DEFINE_ARRAY files BEGIN BEARBLSU END
			LPF patchCreatureScript STR_VAR script=ja#m4su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BEARBLSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~PLYBEAR2~) BEGIN 
