ACTION_FOR_EACH ~file~ IN
	BDBEARBN
	BDBEARBR
	BDGRIZHU
	BEARBR
	BEARBRSU
	PLYBEAR1
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_CRE_EFFECTS
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~B1-8~
			REPLACE_CRE_ITEM ~ja#1m4~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			REPLACE_CRE_ITEM ~ja#2m4~ #0 #0 #0 ~UNDROPPABLE~ ~SHIELD~ 
			LPF clear_proficiencies END
			LPF patchCreature
				INT_VAR
					level1=5
					bonusHp=5
					strength=19
					dexterity=10
					constitution=16
					intelligence=4
					wisdom=13
					charisma=7
					ac=6
					apr=3
					xpv=420
					alignment=IDS_OF_SYMBOL (~align~ ~NEUTRAL~)
					morale=9
					general=IDS_OF_SYMBOL (~general~ ~ANIMAL~)
					race=IDS_OF_SYMBOL (~race~ ~BEAR~)
					class=IDS_OF_SYMBOL (~class~ ~BEAR_BROWN~)
					gender=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					sex=IDS_OF_SYMBOL (~gender~ ~NIETHER~)
					movement=10
					hp=58
					thac0=15
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					enforce=1
					perfect2weapon=1
			END
			DEFINE_ARRAY removeScripts BEGIN CBEAR BEAR END
			DEFINE_ARRAY skipFiles BEGIN BEARBRSU END
			LPF patchCreatureScript STR_VAR script=ja#m4 skipFiles removeScripts END
			DEFINE_ARRAY removeScripts BEGIN CBEAR BEAR END
			DEFINE_ARRAY files BEGIN BEARBRSU END
			LPF patchCreatureScript STR_VAR script=ja#m4su files removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~BEARBRSU~) BEGIN 
				WRITE_LONG 0x14 0 // xpv
				WRITE_BYTE 0x237 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
				WRITE_BYTE 0x275 IDS_OF_SYMBOL (~gender~ ~SUMMONED~) // gender
			END
		BUT_ONLY_IF_IT_CHANGES
	END ELSE BEGIN
		PRINT ~====> CRE %file% not found!~
	END
