COPY_EXISTING ~ja#i1.ITM~  ~override/ja#m16a2.ITM~
	WRITE_SHORT 0x1c 7
	WRITE_ASCII 0x22 ~H5~ #2
	WRITE_LONG 0x60 1
	LPF ADD_ITEM_EQEFFECT
		INT_VAR
			opcode = 7
			target = 1
			parameter1 = 27
			parameter2 = 53
			timing = 2
			probability1 = 100
		END
	LPF ADD_ITEM_EQEFFECT
		INT_VAR
			opcode = 7
			target = 1
			parameter1 = 27
			parameter2 = 52
			timing = 2
			probability1 = 100
		END
	LPF ADD_ITEM_EQEFFECT
		INT_VAR
			opcode = 7
			target = 1
			parameter1 = 27
			parameter2 = 48
			timing = 2
			probability1 = 100
		END

ACTION_FOR_EACH ~file~ IN
	DOOMGU
	DOOMDUR
BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%file%.cre~ BEGIN
		COPY_EXISTING ~%file%.cre~ ~override~
			LPF FJ_CRE_VALIDITY END
			REMOVE_KNOWN_SPELLS
			REMOVE_MEMORIZED_SPELLS
			REMOVE_CRE_ITEM ~HELM13~
			REMOVE_CRE_ITEM ~PLAT07~
			REMOVE_CRE_ITEM ~SW1H11~
			REMOVE_CRE_ITEM ~RING95~
			ADD_CRE_ITEM ~ja#m16w1~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
			ADD_CRE_ITEM ~ja#m16a1~ #0 #0 #0 ~UNDROPPABLE~ ~ARMOR~ 
			ADD_CRE_ITEM ~ja#m16a2~ #0 #0 #0 ~UNDROPPABLE~ ~HELMET~ 
			LPF clearProficiencies END
			SET_BG2_PROFICIENCY ~PROFICIENCYLONGSWORD~ 2
			LPF patchCreature
				INT_VAR
					level1=5
					strength=20
					dexterity=10
					constitution=9
					intelligence=7
					wisdom=11
					charisma=1
					movement=10
					hp=60
					ac=2
					resistFire=50
					resistCold=50
					thac0=15
					apr=1
					xpv=2000
					alignment=34
					saveDeath=11
					saveWand=13
					savePolymorph=12
					saveBreath=13
					saveSpell=14
					morale=20
					moraleBreak=4
					moraleRecovery=15
					general=255
					race=144
					class=2
					gender=4
					sex=4
					enforce=1
			END
			DEFINE_ARRAY removeScripts BEGIN dw1melmo END
			LPF patchCreatureScript STR_VAR script=ja#m16 removeScripts END
			PATCH_IF ("%SOURCE_RES%" STRING_EQUAL_CASE ~DOOMDUR~) BEGIN 
				LPF patchCreature
					INT_VAR
						level1=8
						hp=84
						thac0=13
						saveDeath=10
						saveWand=12
						savePolymorph=11
						saveBreath=12
						saveSpell=13
				END
				SET_BG2_PROFICIENCY ~PROFICIENCYLONGSWORD~ 2
			END
		BUT_ONLY_IF_IT_CHANGES
	END
END