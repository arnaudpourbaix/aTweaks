{
  "name": "ie-baf-generator",
  "version": "0.0.1",
  "description": "Script BAF generator for Infinity Engine games",
  "main": "lib/index.js",
  "bin": {
    "generate": "./lib/index.js"
  },
  "scripts": {
    "start": "nodemon --watch lib/src/**/*.ts --exec ts-node src/index.ts",
    "atweaks": "ts-node lib/src/index.ts",
    "build": "tsc -p .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "coverage:open": "start coverage/index.html",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local": "sudo npm i -g && generate",
    "refresh": "rm -rf ./node_modules ./package-lock.json && npm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnaudpourbaix/ie-baf-generator.git"
  },
  "author": "Arnaud Pourbaix",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/arnaudpourbaix/ie-baf-generator/issues"
  },
  "homepage": "https://github.com/arnaudpourbaix/ie-baf-generator#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "clear": "^0.1.0",
    "commander": "^10.0.0",
    "deepmerge": "^4.3.1",
    "ejs": "^3.1.10",
    "figlet": "^1.5.2",
    "figures": "^6.1.0",
    "glob": "^9.3.4",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/node": "^18.15.11",
    "@vitest/coverage-istanbul": "^2.1.9",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.1.0",
    "nodemon": "^2.0.22",
    "prettier": "^3.9.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.63.0",
    "vitest": "^2.1.9"
  }
}
